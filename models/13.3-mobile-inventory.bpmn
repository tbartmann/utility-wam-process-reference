      <bpmndi:BPMNEdge id="ed_f_n_133_cg2_n_133_adj" bpmnElement="f_n_133_cg2_n_133_adj"><di:waypoint x="853" y="1335"/><di:waypoint x="935" y="1335"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_133_adj_n_133_cend" bpmnElement="f_n_133_adj_n_133_cend"><di:waypoint x="1065" y="1335"/><di:waypoint x="1152" y="1335"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
