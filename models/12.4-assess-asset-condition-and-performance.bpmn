    <bpmndi:BPMNPlane id="pl_P_12_4" bpmnElement="P_12_4">
      <bpmndi:BPMNShape id="sh_n_124_t" bpmnElement="n_124_t"><dc:Bounds x="132" y="217" width="36" height="36"/></bpmndi:BPMNShape>
