<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_16_4" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_16_4" name="16.4 Settle contracted work and evaluate performance" isExecutable="false">
    <documentation>Tier-4 activities under 16.4.1 and 16.4.3; rate validation is 16.4.2 and is called, and the scorecard at 16.4.4 is specified rather than modelled because no source states a scorecard rule. Three objects are kept apart here that a system will happily merge: contract pay units, design compatible units at 2.3 and 2.5, and the plant account 5.3 unitises to. They may coincide. They are not the same document, and settling against the wrong one is how a capital job gets paid at maintenance rates.</documentation>
    <laneSet id="P_16_4_lanes">
      <lane id="l_164_mai" name="Contract administration">
        <flowNodeRef>n_164_start</flowNodeRef>
        <flowNodeRef>n_164_cnt</flowNodeRef>
        <flowNodeRef>n_164_qg</flowNodeRef>
        <flowNodeRef>n_164_chg</flowNodeRef>
        <flowNodeRef>n_164_rate</flowNodeRef>
        <flowNodeRef>n_164_rg</flowNodeRef>
        <flowNodeRef>n_164_hold</flowNodeRef>
        <flowNodeRef>n_164_rwg</flowNodeRef>
        <flowNodeRef>n_164_block</flowNodeRef>
        <flowNodeRef>n_164_fb</flowNodeRef>
        <flowNodeRef>n_164_end</flowNodeRef>
      </lane>
      <lane id="l_164_fin" name="Finance">
        <flowNodeRef>n_164_auth</flowNodeRef>
        <flowNodeRef>n_164_rem</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="n_164_start" name="Contracted work accepted"><messageEventDefinition id="n_164_start_md"/></startEvent>
    <serviceTask id="n_164_cnt" name="Capture units and quantities in contract units"><documentation>16.4.1. Contract pay units, not design compatible units.</documentation></serviceTask>
    <exclusiveGateway id="n_164_qg" name="Quantities within the award"/>
    <userTask id="n_164_chg" name="Raise the quantity outside the award as a change"><documentation>16.4.1. A quantity the award did not allow is a change, not a quiet extra.</documentation></userTask>
    <businessRuleTask id="n_164_rate" name="Validate against contract rates (16.4.2)"><documentation>16.4.2. Rate tables are the contract's. EN 13269 is cited by title only and no rate is derived from it.</documentation></businessRuleTask>
    <exclusiveGateway id="n_164_rg" name="Line outcome"/>
    <userTask id="n_164_hold" name="Hold or reject the line"><documentation>16.4.2. A payable amount with no awarded rate is not validated, it is asserted.</documentation></userTask>
    <exclusiveGateway id="n_164_rwg" name="Open rework hold on the line"/>
    <endEvent id="n_164_block" name="Blocked by a rework hold"><documentation>16.4.3. Paying a line 16.3.4 is holding is a control failure, not a settlement success.</documentation></endEvent>
    <userTask id="n_164_auth" name="Authorise payment"><documentation>16.4.3. Contractor pay. 13.4.4 is a goods-supplier invoice and 5.3 is plant cost - three different objects. EN 17007 has no payment-authorisation process; cl. 6.8 BUD.4 extracts budgeted and actual expenditures and is the closest.</documentation></userTask>
    <serviceTask id="n_164_rem" name="Record the remittance against the award"><documentation>16.4.3.</documentation></serviceTask>
    <sendTask id="n_164_fb" name="Feed the outcome to the contractor score"><documentation>16.4.4 holds the standing score. It is specified and not modelled because no source in the pack states a scorecard rule; EN 17007 cl. 6.15 SER.3 evaluate companies and services is the closest name.</documentation></sendTask>
    <endEvent id="n_164_end" name="Contracted work settled"/>
    <sequenceFlow id="f_n_164_start_n_164_cnt" sourceRef="n_164_start" targetRef="n_164_cnt" name=""/>
    <sequenceFlow id="f_n_164_cnt_n_164_qg" sourceRef="n_164_cnt" targetRef="n_164_qg" name=""/>
    <sequenceFlow id="f_n_164_qg_n_164_chg" sourceRef="n_164_qg" targetRef="n_164_chg" name="outside the award"><conditionExpression xsi:type="tFormalExpression"><![CDATA[withinAward = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_164_chg_n_164_rate" sourceRef="n_164_chg" targetRef="n_164_rate" name="change approved"/>
    <sequenceFlow id="f_n_164_qg_n_164_rate" sourceRef="n_164_qg" targetRef="n_164_rate" name="within the award"/>
    <sequenceFlow id="f_n_164_rate_n_164_rg" sourceRef="n_164_rate" targetRef="n_164_rg" name=""/>
    <sequenceFlow id="f_n_164_rg_n_164_hold" sourceRef="n_164_rg" targetRef="n_164_hold" name="hold or reject"><conditionExpression xsi:type="tFormalExpression"><![CDATA[lineOutcome != "payable"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_164_hold_n_164_rate" sourceRef="n_164_hold" targetRef="n_164_rate" name="resolved"/>
    <sequenceFlow id="f_n_164_rg_n_164_rwg" sourceRef="n_164_rg" targetRef="n_164_rwg" name="payable"/>
    <sequenceFlow id="f_n_164_rwg_n_164_block" sourceRef="n_164_rwg" targetRef="n_164_block" name="rework hold open"><conditionExpression xsi:type="tFormalExpression"><![CDATA[reworkHold = true]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_164_rwg_n_164_auth" sourceRef="n_164_rwg" targetRef="n_164_auth" name="no hold"/>
    <sequenceFlow id="f_n_164_auth_n_164_rem" sourceRef="n_164_auth" targetRef="n_164_rem" name=""/>
    <sequenceFlow id="f_n_164_rem_n_164_fb" sourceRef="n_164_rem" targetRef="n_164_fb" name=""/>
    <sequenceFlow id="f_n_164_fb_n_164_end" sourceRef="n_164_fb" targetRef="n_164_end" name=""/>
  </process>
  <bpmndi:BPMNDiagram id="dg_P_16_4">
    <bpmndi:BPMNPlane id="pl_P_16_4" bpmnElement="P_16_4">
      <bpmndi:BPMNShape id="sh_n_164_start" bpmnElement="n_164_start"><dc:Bounds x="132" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_cnt" bpmnElement="n_164_cnt"><dc:Bounds x="255" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_qg" bpmnElement="n_164_qg"><dc:Bounds x="467" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_chg" bpmnElement="n_164_chg"><dc:Bounds x="425" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_rate" bpmnElement="n_164_rate"><dc:Bounds x="595" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_rg" bpmnElement="n_164_rg"><dc:Bounds x="807" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_hold" bpmnElement="n_164_hold"><dc:Bounds x="765" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_rwg" bpmnElement="n_164_rwg"><dc:Bounds x="977" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_block" bpmnElement="n_164_block"><dc:Bounds x="982" y="437" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_auth" bpmnElement="n_164_auth"><dc:Bounds x="1105" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_rem" bpmnElement="n_164_rem"><dc:Bounds x="1275" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_fb" bpmnElement="n_164_fb"><dc:Bounds x="1445" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_164_end" bpmnElement="n_164_end"><dc:Bounds x="1662" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_164_start_n_164_cnt" bpmnElement="f_n_164_start_n_164_cnt"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_cnt_n_164_qg" bpmnElement="f_n_164_cnt_n_164_qg"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_qg_n_164_chg" bpmnElement="f_n_164_qg_n_164_chg"><di:waypoint x="513" y="235"/><di:waypoint x="400" y="235"/><di:waypoint x="400" y="455"/><di:waypoint x="425" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_chg_n_164_rate" bpmnElement="f_n_164_chg_n_164_rate"><di:waypoint x="555" y="455"/><di:waypoint x="570" y="455"/><di:waypoint x="570" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_qg_n_164_rate" bpmnElement="f_n_164_qg_n_164_rate"><di:waypoint x="513" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_rate_n_164_rg" bpmnElement="f_n_164_rate_n_164_rg"><di:waypoint x="725" y="235"/><di:waypoint x="807" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_rg_n_164_hold" bpmnElement="f_n_164_rg_n_164_hold"><di:waypoint x="853" y="235"/><di:waypoint x="740" y="235"/><di:waypoint x="740" y="455"/><di:waypoint x="765" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_hold_n_164_rate" bpmnElement="f_n_164_hold_n_164_rate"><di:waypoint x="895" y="455"/><di:waypoint x="570" y="455"/><di:waypoint x="570" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_rg_n_164_rwg" bpmnElement="f_n_164_rg_n_164_rwg"><di:waypoint x="853" y="235"/><di:waypoint x="977" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_rwg_n_164_block" bpmnElement="f_n_164_rwg_n_164_block"><di:waypoint x="1023" y="235"/><di:waypoint x="957" y="235"/><di:waypoint x="957" y="455"/><di:waypoint x="982" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_rwg_n_164_auth" bpmnElement="f_n_164_rwg_n_164_auth"><di:waypoint x="1023" y="235"/><di:waypoint x="1105" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_auth_n_164_rem" bpmnElement="f_n_164_auth_n_164_rem"><di:waypoint x="1235" y="235"/><di:waypoint x="1275" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_rem_n_164_fb" bpmnElement="f_n_164_rem_n_164_fb"><di:waypoint x="1405" y="235"/><di:waypoint x="1445" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_164_fb_n_164_end" bpmnElement="f_n_164_fb_n_164_end"><di:waypoint x="1575" y="235"/><di:waypoint x="1662" y="235"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
