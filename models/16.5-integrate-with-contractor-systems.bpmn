<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_16_5" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_16_5" name="16.5 Integrate with contractor systems" isExecutable="false">
    <documentation>Tier-4 activities under 16.5.2, 16.5.3 and 16.5.4. Access provision, crew federation and the exception case are elsewhere - two are standing records and one is 16.5.6. This is the message layer and 16.3 is the management layer: 16.5.3 validates that an inbound message belongs to an award and hands it on, while 16.3.1 and 16.3.2 decide what it means. The duplication is deliberate and is the same split as 13.7 against 13.4. IEC 61968-6 Annex A supplies the verbs and MultiSpeak V5.0 defines work-management interfaces for electric cooperatives, dormant since 2021; PIDX is excluded by the pack. Channel beyond that is operator judgment.</documentation>
    <laneSet id="P_16_5_lanes">
      <lane id="l_165_if" name="Contractor interface">
        <flowNodeRef>n_165_out</flowNodeRef>
        <flowNodeRef>n_165_tx</flowNodeRef>
        <flowNodeRef>n_165_w</flowNodeRef>
        <flowNodeRef>n_165_ack</flowNodeRef>
        <flowNodeRef>n_165_sil</flowNodeRef>
        <flowNodeRef>n_165_sexc</flowNodeRef>
        <flowNodeRef>n_165_w24</flowNodeRef>
        <flowNodeRef>n_165_in</flowNodeRef>
        <flowNodeRef>n_165_val</flowNodeRef>
        <flowNodeRef>n_165_vg</flowNodeRef>
        <flowNodeRef>n_165_quar</flowNodeRef>
        <flowNodeRef>n_165_hand</flowNodeRef>
        <flowNodeRef>n_165_end</flowNodeRef>
      </lane>
      <lane id="l_165_fin" name="Settlement exchange">
        <flowNodeRef>n_165_u</flowNodeRef>
        <flowNodeRef>n_165_send</flowNodeRef>
        <flowNodeRef>n_165_rcv</flowNodeRef>
        <flowNodeRef>n_165_mg</flowNodeRef>
        <flowNodeRef>n_165_mexc</flowNodeRef>
        <flowNodeRef>n_165_q</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="n_165_out" name="Assignment ready to send"><messageEventDefinition id="n_165_out_md"/></startEvent>
    <sendTask id="n_165_tx" name="Transmit the assignment"><documentation>16.5.2.</documentation></sendTask>
    <eventBasedGateway id="n_165_w" name="Reply or silence"/>
    <receiveTask id="n_165_ack" name="Receive acceptance or reject"><documentation>16.5.2.</documentation></receiveTask>
    <startEvent id="n_165_sil" name="Reply window elapsed"><timerEventDefinition id="n_165_sil_td"/></startEvent>
    <userTask id="n_165_sexc" name="Except the silent assignment"><documentation>16.5.2. A portal click that never became a message is still silence here.</documentation></userTask>
    <sendTask id="n_165_w24" name="Write the result onto 16.2.4"><documentation>16.5.2.</documentation></sendTask>
    <startEvent id="n_165_in" name="Progress or completion message arrives"><messageEventDefinition id="n_165_in_md"/></startEvent>
    <serviceTask id="n_165_val" name="Validate that it belongs to an open award"><documentation>16.5.3.</documentation></serviceTask>
    <exclusiveGateway id="n_165_vg" name="Matched to an award"/>
    <sendTask id="n_165_quar" name="Quarantine the unmatched message"><documentation>16.5.3. Unmatched messages are not progress. 16.5.6 reconciles them.</documentation></sendTask>
    <sendTask id="n_165_hand" name="Hand it to 16.3.1 or 16.3.2"><documentation>16.5.3. IEC 61968-6 is electric-scoped and gas borrows it; offline mobile capture is vendor-defined.</documentation></sendTask>
    <startEvent id="n_165_u" name="Units or a quantity claim to exchange"><messageEventDefinition id="n_165_u_md"/></startEvent>
    <sendTask id="n_165_send" name="Send the counted units"><documentation>16.5.4. 16.4.1 captures them; this transmits them.</documentation></sendTask>
    <receiveTask id="n_165_rcv" name="Receive the contractor quantity claim"><documentation>16.5.4. 13.7.5 exchanges goods invoices; this exchanges contractor pay units.</documentation></receiveTask>
    <exclusiveGateway id="n_165_mg" name="Claim matches the counted units"/>
    <sendTask id="n_165_mexc" name="Record the mismatch for 16.5.6"><documentation>16.5.4. A contractor claim that never meets 16.4.2 is not payable because it arrived.</documentation></sendTask>
    <sendTask id="n_165_q" name="Put both on the 16.4.1 and 16.4.2 queue"><documentation>16.5.4.</documentation></sendTask>
    <endEvent id="n_165_end" name="Exchange complete"/>
    <sequenceFlow id="f_n_165_out_n_165_tx" sourceRef="n_165_out" targetRef="n_165_tx" name=""/>
    <sequenceFlow id="f_n_165_tx_n_165_w" sourceRef="n_165_tx" targetRef="n_165_w" name=""/>
    <sequenceFlow id="f_n_165_w_n_165_ack" sourceRef="n_165_w" targetRef="n_165_ack" name="reply"/>
    <sequenceFlow id="f_n_165_ack_n_165_w24" sourceRef="n_165_ack" targetRef="n_165_w24" name=""/>
    <sequenceFlow id="f_n_165_w24_n_165_end" sourceRef="n_165_w24" targetRef="n_165_end" name=""/>
    <sequenceFlow id="f_n_165_sil_n_165_sexc" sourceRef="n_165_sil" targetRef="n_165_sexc" name=""/>
    <sequenceFlow id="f_n_165_sexc_n_165_end" sourceRef="n_165_sexc" targetRef="n_165_end" name=""/>
    <sequenceFlow id="f_n_165_in_n_165_val" sourceRef="n_165_in" targetRef="n_165_val" name=""/>
    <sequenceFlow id="f_n_165_val_n_165_vg" sourceRef="n_165_val" targetRef="n_165_vg" name=""/>
    <sequenceFlow id="f_n_165_vg_n_165_quar" sourceRef="n_165_vg" targetRef="n_165_quar" name="no matching award"><conditionExpression xsi:type="tFormalExpression"><![CDATA[matchedToAward = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_165_vg_n_165_hand" sourceRef="n_165_vg" targetRef="n_165_hand" name="matched"/>
    <sequenceFlow id="f_n_165_hand_n_165_end" sourceRef="n_165_hand" targetRef="n_165_end" name=""/>
    <sequenceFlow id="f_n_165_quar_n_165_end" sourceRef="n_165_quar" targetRef="n_165_end" name=""/>
    <sequenceFlow id="f_n_165_u_n_165_send" sourceRef="n_165_u" targetRef="n_165_send" name=""/>
    <sequenceFlow id="f_n_165_send_n_165_rcv" sourceRef="n_165_send" targetRef="n_165_rcv" name=""/>
    <sequenceFlow id="f_n_165_rcv_n_165_mg" sourceRef="n_165_rcv" targetRef="n_165_mg" name=""/>
    <sequenceFlow id="f_n_165_mg_n_165_mexc" sourceRef="n_165_mg" targetRef="n_165_mexc" name="mismatch"><conditionExpression xsi:type="tFormalExpression"><![CDATA[claimMatches = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_165_mg_n_165_q" sourceRef="n_165_mg" targetRef="n_165_q" name="matches"/>
    <sequenceFlow id="f_n_165_q_n_165_end" sourceRef="n_165_q" targetRef="n_165_end" name=""/>
    <sequenceFlow id="f_n_165_mexc_n_165_end" sourceRef="n_165_mexc" targetRef="n_165_end" name=""/>
  </process>
  <bpmndi:BPMNDiagram id="dg_P_16_5">
    <bpmndi:BPMNPlane id="pl_P_16_5" bpmnElement="P_16_5">
      <bpmndi:BPMNShape id="sh_n_165_out" bpmnElement="n_165_out"><dc:Bounds x="132" y="217" width="36" height="36"/></bpmndi:BPMNShape>
