      <bpmndi:BPMNShape id="sh_n_124_gw" bpmnElement="n_124_gw"><dc:Bounds x="1147" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_124_case" bpmnElement="n_124_case"><dc:Bounds x="1105" y="411.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_124_e1" bpmnElement="n_124_e1"><dc:Bounds x="1322" y="217" width="36" height="36"/></bpmndi:BPMNShape>
