      <bpmndi:BPMNShape id="sh_n_26_ren" bpmnElement="n_26_ren"><dc:Bounds x="935" y="750" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_26_lapse" bpmnElement="n_26_lapse"><dc:Bounds x="1105" y="750" width="130" height="70"/></bpmndi:BPMNShape>
