      <bpmndi:BPMNShape id="sh_n_122_fix" bpmnElement="n_122_fix"><dc:Bounds x="935" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_case" bpmnElement="n_122_case"><dc:Bounds x="765" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_e1" bpmnElement="n_122_e1"><dc:Bounds x="1152" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_p" bpmnElement="n_122_p"><dc:Bounds x="132" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_res" bpmnElement="n_122_res"><dc:Bounds x="255" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_app" bpmnElement="n_122_app"><dc:Bounds x="425" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_ok" bpmnElement="n_122_ok"><dc:Bounds x="637" y="652" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_exc" bpmnElement="n_122_exc"><dc:Bounds x="595" y="860" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_e2" bpmnElement="n_122_e2"><dc:Bounds x="812" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_c" bpmnElement="n_122_c"><dc:Bounds x="132" y="1097" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_cres" bpmnElement="n_122_cres"><dc:Bounds x="255" y="1080" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_cupd" bpmnElement="n_122_cupd"><dc:Bounds x="425" y="1080" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_cack" bpmnElement="n_122_cack"><dc:Bounds x="595" y="1080" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_122_e3" bpmnElement="n_122_e3"><dc:Bounds x="812" y="1097" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_122_t_n_122_scope" bpmnElement="f_n_122_t_n_122_scope"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
