      <bpmndi:BPMNEdge id="ed_f_n_124_rec_n_124_gw" bpmnElement="f_n_124_rec_n_124_gw"><di:waypoint x="1065" y="235"/><di:waypoint x="1147" y="235"/></bpmndi:BPMNEdge>
