      <bpmndi:BPMNShape id="sh_n_126_raise" bpmnElement="n_126_raise"><dc:Bounds x="935" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_126_e1" bpmnElement="n_126_e1"><dc:Bounds x="1152" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_126_c" bpmnElement="n_126_c"><dc:Bounds x="132" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_126_reg" bpmnElement="n_126_reg"><dc:Bounds x="255" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_126_ass" bpmnElement="n_126_ass"><dc:Bounds x="425" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_126_dec" bpmnElement="n_126_dec"><dc:Bounds x="637" y="652" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_126_no" bpmnElement="n_126_no"><dc:Bounds x="642" y="877" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_126_impl" bpmnElement="n_126_impl"><dc:Bounds x="765" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_126_ver" bpmnElement="n_126_ver"><dc:Bounds x="935" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_126_e2" bpmnElement="n_126_e2"><dc:Bounds x="1152" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_126_o_n_126_scope" bpmnElement="f_n_126_o_n_126_scope"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
