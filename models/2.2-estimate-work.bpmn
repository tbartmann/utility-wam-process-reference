      <bpmndi:BPMNEdge id="ed_f_n_22_allow_n_22_est" bpmnElement="f_n_22_allow_n_22_est"><di:waypoint x="1405" y="345"/><di:waypoint x="1445" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_est_n_22_end" bpmnElement="f_n_22_est_n_22_end"><di:waypoint x="1575" y="345"/><di:waypoint x="1662" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_rstart_n_22_reest" bpmnElement="f_n_22_rstart_n_22_reest"><di:waypoint x="1188" y="675"/><di:waypoint x="1275" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_reest_n_22_rclass" bpmnElement="f_n_22_reest_n_22_rclass"><di:waypoint x="1405" y="675"/><di:waypoint x="1445" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_rclass_n_22_keep" bpmnElement="f_n_22_rclass_n_22_keep"><di:waypoint x="1575" y="675"/><di:waypoint x="1615" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_keep_n_22_rend" bpmnElement="f_n_22_keep_n_22_rend"><di:waypoint x="1745" y="675"/><di:waypoint x="1832" y="675"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
