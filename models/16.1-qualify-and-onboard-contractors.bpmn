      <bpmndi:BPMNEdge id="ed_f_n_161_org_n_161_og" bpmnElement="f_n_161_org_n_161_og"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_161_og_n_161_rej" bpmnElement="f_n_161_og_n_161_rej"><di:waypoint x="513" y="235"/><di:waypoint x="447" y="235"/><di:waypoint x="447" y="455"/><di:waypoint x="472" y="455"/></bpmndi:BPMNEdge>
