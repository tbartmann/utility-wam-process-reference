      <bpmndi:BPMNEdge id="ed_f_n_24_lib_n_24_std" bpmnElement="f_n_24_lib_n_24_std"><di:waypoint x="343" y="235"/><di:waypoint x="230" y="235"/><di:waypoint x="230" y="125"/><di:waypoint x="255" y="125"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="148.2" y="110" width="76.8" height="30" />
