      <bpmndi:BPMNEdge id="ed_f_n_52_exc_n_52_all" bpmnElement="f_n_52_exc_n_52_all"><di:waypoint x="1235" y="455"/><di:waypoint x="1122" y="455"/><di:waypoint x="1122" y="235"/><di:waypoint x="1147" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_52_all_n_52_oh" bpmnElement="f_n_52_all_n_52_oh"><di:waypoint x="1193" y="235"/><di:waypoint x="1275" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_52_oh_n_52_set" bpmnElement="f_n_52_oh_n_52_set"><di:waypoint x="1405" y="235"/><di:waypoint x="1445" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_52_set_n_52_fix" bpmnElement="f_n_52_set_n_52_fix"><di:waypoint x="1575" y="235"/><di:waypoint x="1615" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_52_fix_n_52_end" bpmnElement="f_n_52_fix_n_52_end"><di:waypoint x="1745" y="235"/><di:waypoint x="1832" y="235"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
