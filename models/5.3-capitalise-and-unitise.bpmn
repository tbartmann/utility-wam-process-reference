      <bpmndi:BPMNShape id="sh_n_53_gate" bpmnElement="n_53_gate"><dc:Bounds x="467" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_exp" bpmnElement="n_53_exp"><dc:Bounds x="425" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_endexp" bpmnElement="n_53_endexp"><dc:Bounds x="642" y="437" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_add" bpmnElement="n_53_add"><dc:Bounds x="595" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_rem" bpmnElement="n_53_rem"><dc:Bounds x="765" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_dist" bpmnElement="n_53_dist"><dc:Bounds x="935" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_post" bpmnElement="n_53_post"><dc:Bounds x="1105" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_cpr" bpmnElement="n_53_cpr"><dc:Bounds x="1275" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_rec" bpmnElement="n_53_rec"><dc:Bounds x="1445" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_pj" bpmnElement="n_53_pj"><dc:Bounds x="1657" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_var" bpmnElement="n_53_var"><dc:Bounds x="1615" y="90" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_close" bpmnElement="n_53_close"><dc:Bounds x="1785" y="90" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_end" bpmnElement="n_53_end"><dc:Bounds x="2002" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_53_start_n_53_conf" bpmnElement="f_n_53_start_n_53_conf"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_conf_n_53_gate" bpmnElement="f_n_53_conf_n_53_gate"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_gate_n_53_exp" bpmnElement="f_n_53_gate_n_53_exp"><di:waypoint x="513" y="235"/><di:waypoint x="400" y="235"/><di:waypoint x="400" y="455"/><di:waypoint x="425" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_exp_n_53_endexp" bpmnElement="f_n_53_exp_n_53_endexp"><di:waypoint x="555" y="455"/><di:waypoint x="642" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_gate_n_53_add" bpmnElement="f_n_53_gate_n_53_add"><di:waypoint x="513" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_add_n_53_rem" bpmnElement="f_n_53_add_n_53_rem"><di:waypoint x="725" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_rem_n_53_dist" bpmnElement="f_n_53_rem_n_53_dist"><di:waypoint x="895" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_dist_n_53_post" bpmnElement="f_n_53_dist_n_53_post"><di:waypoint x="1065" y="235"/><di:waypoint x="1105" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_post_n_53_cpr" bpmnElement="f_n_53_post_n_53_cpr"><di:waypoint x="1235" y="235"/><di:waypoint x="1275" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_cpr_n_53_rec" bpmnElement="f_n_53_cpr_n_53_rec"><di:waypoint x="1405" y="235"/><di:waypoint x="1445" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_rec_n_53_pj" bpmnElement="f_n_53_rec_n_53_pj"><di:waypoint x="1575" y="235"/><di:waypoint x="1657" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_pj_n_53_var" bpmnElement="f_n_53_pj_n_53_var"><di:waypoint x="1703" y="235"/><di:waypoint x="1590" y="235"/><di:waypoint x="1590" y="125"/><di:waypoint x="1615" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_var_n_53_close" bpmnElement="f_n_53_var_n_53_close"><di:waypoint x="1745" y="125"/><di:waypoint x="1785" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_close_n_53_end" bpmnElement="f_n_53_close_n_53_end"><di:waypoint x="1915" y="125"/><di:waypoint x="1977" y="125"/><di:waypoint x="1977" y="235"/><di:waypoint x="2002" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_53_pj_n_53_end" bpmnElement="f_n_53_pj_n_53_end"><di:waypoint x="1703" y="235"/><di:waypoint x="2002" y="235"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
