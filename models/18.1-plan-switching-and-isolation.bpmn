      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_181_gw_n_181_gas" bpmnElement="f_n_181_gw_n_181_gas"><di:waypoint x="513" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="455"/><di:waypoint x="595" y="455"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="488.2" y="440" width="76.8" height="30" />
