      <bpmndi:BPMNEdge id="ed_f_n_45_rem_n_45_end2" bpmnElement="f_n_45_rem_n_45_end2"><di:waypoint x="1065" y="675"/><di:waypoint x="1152" y="675"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
