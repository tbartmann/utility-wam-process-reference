      <bpmndi:BPMNShape id="sh_n_62_dev" bpmnElement="n_62_dev"><dc:Bounds x="595" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_62_link" bpmnElement="n_62_link"><dc:Bounds x="765" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_62_pass" bpmnElement="n_62_pass"><dc:Bounds x="935" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_62_ok" bpmnElement="n_62_ok"><dc:Bounds x="1147" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_62_case" bpmnElement="n_62_case"><dc:Bounds x="1105" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_62_close" bpmnElement="n_62_close"><dc:Bounds x="1275" y="200" width="130" height="70"/></bpmndi:BPMNShape>
