      <bpmndi:BPMNShape id="sh_n_182_mat" bpmnElement="n_182_mat"><dc:Bounds x="255" y="851.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_182_crew" bpmnElement="n_182_crew"><dc:Bounds x="425" y="851.5" width="130" height="87"/></bpmndi:BPMNShape>
