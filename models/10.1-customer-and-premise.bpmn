<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_10_1" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_10_1" name="10.1 Maintain customer and premise information" isExecutable="false">
    <documentation>Only 10.1.2 has an instance boundary. Identity binding, site notes and contact preference are standing records specified in the category and not drawn here. The point of this path is the last step: history that never becomes visible to the next visit is history nobody has.</documentation>
    <laneSet id="P_10_1_lanes">
      <lane id="l_101_cs" name="Customer service">
        <flowNodeRef>n_101_start</flowNodeRef>
        <flowNodeRef>n_101_rec</flowNodeRef>
        <flowNodeRef>n_101_bind</flowNodeRef>
        <flowNodeRef>n_101_cg</flowNodeRef>
        <flowNodeRef>n_101_vis</flowNodeRef>
        <flowNodeRef>n_101_end</flowNodeRef>
      </lane>
      <lane id="l_101_schd" name="Scheduling">
        <flowNodeRef>n_101_com</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="n_101_start" name="Contact or field outcome to record"><messageEventDefinition id="n_101_start_md"/></startEvent>
    <serviceTask id="n_101_rec" name="Record the contact, channel and subject"><documentation>10.1.2.</documentation></serviceTask>
    <serviceTask id="n_101_bind" name="Attach it to the bound premise and account"><documentation>10.1.2. 10.1.1 did the binding. Account-to-premise matching is not standardised and the operator's rule is what applies.</documentation></serviceTask>
    <exclusiveGateway id="n_101_cg" name="A commitment was made"/>
    <sendTask id="n_101_com" name="Publish the commitment to scheduling"><documentation>10.1.2. A commitment not written here is invisible to 3.3 and to 10.2.2, and the customer is the only party who knows it exists.</documentation></sendTask>
    <serviceTask id="n_101_vis" name="Make the history visible to the next field visit"><documentation>10.1.2. Including anything 10.1.3 should hold as an access or hazard note.</documentation></serviceTask>
    <endEvent id="n_101_end" name="Interaction on the premise history"/>
    <sequenceFlow id="f_n_101_start_n_101_rec" sourceRef="n_101_start" targetRef="n_101_rec" name=""/>
    <sequenceFlow id="f_n_101_rec_n_101_bind" sourceRef="n_101_rec" targetRef="n_101_bind" name=""/>
    <sequenceFlow id="f_n_101_bind_n_101_cg" sourceRef="n_101_bind" targetRef="n_101_cg" name=""/>
    <sequenceFlow id="f_n_101_cg_n_101_com" sourceRef="n_101_cg" targetRef="n_101_com" name="commitment given"><conditionExpression xsi:type="tFormalExpression"><![CDATA[commitmentGiven = true]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_101_com_n_101_vis" sourceRef="n_101_com" targetRef="n_101_vis" name=""/>
    <sequenceFlow id="f_n_101_cg_n_101_vis" sourceRef="n_101_cg" targetRef="n_101_vis" name="no commitment"/>
    <sequenceFlow id="f_n_101_vis_n_101_end" sourceRef="n_101_vis" targetRef="n_101_end" name=""/>
  </process>
  <bpmndi:BPMNDiagram id="dg_P_10_1">
    <bpmndi:BPMNPlane id="pl_P_10_1" bpmnElement="P_10_1">
      <bpmndi:BPMNShape id="sh_n_101_start" bpmnElement="n_101_start"><dc:Bounds x="132" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_101_rec" bpmnElement="n_101_rec"><dc:Bounds x="255" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_101_bind" bpmnElement="n_101_bind"><dc:Bounds x="425" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_101_cg" bpmnElement="n_101_cg"><dc:Bounds x="637" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_101_com" bpmnElement="n_101_com"><dc:Bounds x="765" y="90" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_101_vis" bpmnElement="n_101_vis"><dc:Bounds x="765" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_101_end" bpmnElement="n_101_end"><dc:Bounds x="982" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_101_start_n_101_rec" bpmnElement="f_n_101_start_n_101_rec"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_101_rec_n_101_bind" bpmnElement="f_n_101_rec_n_101_bind"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_101_bind_n_101_cg" bpmnElement="f_n_101_bind_n_101_cg"><di:waypoint x="555" y="235"/><di:waypoint x="637" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_101_cg_n_101_com" bpmnElement="f_n_101_cg_n_101_com"><di:waypoint x="683" y="235"/><di:waypoint x="740" y="235"/><di:waypoint x="740" y="125"/><di:waypoint x="765" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_101_com_n_101_vis" bpmnElement="f_n_101_com_n_101_vis"><di:waypoint x="895" y="125"/><di:waypoint x="740" y="125"/><di:waypoint x="740" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_101_cg_n_101_vis" bpmnElement="f_n_101_cg_n_101_vis"><di:waypoint x="683" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_101_vis_n_101_end" bpmnElement="f_n_101_vis_n_101_end"><di:waypoint x="895" y="235"/><di:waypoint x="982" y="235"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
