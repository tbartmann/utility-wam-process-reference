<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_3_3" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_3_3" name="3.3 Manage appointments" isExecutable="false">
    <documentation>Tier-4 activities under 3.3.2, 3.3.3 and 3.3.4. Window determination is in 3.3.1-offer-appointment-windows.dmn. An amend re-enters the determination and the reservation rather than editing a held window in place - that is what keeps the reservation honest when the window has since gone.</documentation>
    <startEvent id="n_33_start" name="A window has been chosen and must be held"><messageEventDefinition id="n_33_start_md"/></startEvent>
    <serviceTask id="n_33_take" name="Take the chosen window and the work it covers"><documentation>3.3.2.</documentation></serviceTask>
    <serviceTask id="n_33_free" name="Test that the capacity is still free"><documentation>3.3.2. Request-reply against scheduling; the window may have gone since it was offered.</documentation></serviceTask>
    <exclusiveGateway id="n_33_gate" name="Still free"/>
    <sendTask id="n_33_rej" name="Reject the reservation"><documentation>3.3.2. The caller returns to 3.3.1 for a fresh set of windows.</documentation></sendTask>
    <endEvent id="n_33_endrej" name="Window already taken"/>
    <serviceTask id="n_33_res" name="Reserve the hours and skill against the work"><documentation>3.3.2.</documentation></serviceTask>
    <sendTask id="n_33_conf" name="Confirm the window to the customer and the schedule"><documentation>3.3.3. Confirmation is what makes the appointment binding on the operator.</documentation></sendTask>
    <eventBasedGateway id="n_33_ev" name=""/>
    <receiveTask id="n_33_amend" name="Amend request received"><documentation>3.3.3. Customer-initiated or operator-initiated; both re-enter 3.3.1 and 3.3.2.</documentation></receiveTask>
    <receiveTask id="n_33_cancel" name="Cancel request received"><documentation>3.3.3.</documentation></receiveTask>
    <receiveTask id="n_33_fail" name="Window passed without a completed visit"><documentation>3.3.4. Message start of the failure path.</documentation></receiveTask>
    <serviceTask id="n_33_rel" name="Release the reserved capacity"><documentation>3.3.3. Capacity not released is capacity lost, and it is invisible.</documentation></serviceTask>
    <userTask id="n_33_why" name="Record the failure and who missed it"><documentation>3.3.4. Customer no-access, crew late or unable, or a hazard or access condition found on arrival. The three lead to different actions and different measures.</documentation></userTask>
    <exclusiveGateway id="n_33_hold" name="Work still stands"/>
    <callActivity id="n_33_re" name="Offer a new window"><documentation>3.3.4. Calls decision Appointment_windows through 3.3.1.</documentation></callActivity>
    <serviceTask id="n_33_close" name="Close and keep the failure visible to planning"><documentation>3.3.4. Visible, or the same premise fails again next cycle.</documentation></serviceTask>
    <endEvent id="n_33_end" name="Appointment closed or rebooked"/>
    <sequenceFlow id="f_n_33_start_n_33_take" sourceRef="n_33_start" targetRef="n_33_take" name=""/>
    <sequenceFlow id="f_n_33_take_n_33_free" sourceRef="n_33_take" targetRef="n_33_free" name=""/>
    <sequenceFlow id="f_n_33_free_n_33_gate" sourceRef="n_33_free" targetRef="n_33_gate" name=""/>
    <sequenceFlow id="f_n_33_gate_n_33_rej" sourceRef="n_33_gate" targetRef="n_33_rej" name="gone"><conditionExpression xsi:type="tFormalExpression"><![CDATA[capacityStillFree = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_33_rej_n_33_endrej" sourceRef="n_33_rej" targetRef="n_33_endrej" name=""/>
    <sequenceFlow id="f_n_33_gate_n_33_res" sourceRef="n_33_gate" targetRef="n_33_res" name="free"/>
    <sequenceFlow id="f_n_33_res_n_33_conf" sourceRef="n_33_res" targetRef="n_33_conf" name=""/>
    <sequenceFlow id="f_n_33_conf_n_33_ev" sourceRef="n_33_conf" targetRef="n_33_ev" name=""/>
    <sequenceFlow id="f_n_33_ev_n_33_amend" sourceRef="n_33_ev" targetRef="n_33_amend" name=""/>
    <sequenceFlow id="f_n_33_ev_n_33_cancel" sourceRef="n_33_ev" targetRef="n_33_cancel" name=""/>
    <sequenceFlow id="f_n_33_ev_n_33_fail" sourceRef="n_33_ev" targetRef="n_33_fail" name=""/>
    <sequenceFlow id="f_n_33_amend_n_33_rel" sourceRef="n_33_amend" targetRef="n_33_rel" name=""/>
    <sequenceFlow id="f_n_33_cancel_n_33_rel" sourceRef="n_33_cancel" targetRef="n_33_rel" name=""/>
    <sequenceFlow id="f_n_33_rel_n_33_re" sourceRef="n_33_rel" targetRef="n_33_re" name="amend - offer again"><conditionExpression xsi:type="tFormalExpression"><![CDATA[appointmentOutcome = "amend"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_33_rel_n_33_end" sourceRef="n_33_rel" targetRef="n_33_end" name="cancel"/>
    <sequenceFlow id="f_n_33_fail_n_33_why" sourceRef="n_33_fail" targetRef="n_33_why" name=""/>
    <sequenceFlow id="f_n_33_why_n_33_hold" sourceRef="n_33_why" targetRef="n_33_hold" name=""/>
    <sequenceFlow id="f_n_33_hold_n_33_re" sourceRef="n_33_hold" targetRef="n_33_re" name="work still stands"><conditionExpression xsi:type="tFormalExpression"><![CDATA[workStillRequired = true]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_33_hold_n_33_close" sourceRef="n_33_hold" targetRef="n_33_close" name="work no longer required"/>
    <sequenceFlow id="f_n_33_re_n_33_end" sourceRef="n_33_re" targetRef="n_33_end" name=""/>
    <sequenceFlow id="f_n_33_close_n_33_end" sourceRef="n_33_close" targetRef="n_33_end" name=""/>
  </process>
