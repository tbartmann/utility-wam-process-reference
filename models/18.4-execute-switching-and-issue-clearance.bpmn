      <bpmndi:BPMNEdge id="ed_f_n_184_loto_n_184_gend" bpmnElement="f_n_184_loto_n_184_gend"><di:waypoint x="1405" y="675"/><di:waypoint x="1492" y="675"/></bpmndi:BPMNEdge>
