      <bpmndi:BPMNEdge id="ed_f_n_62_close_n_62_end" bpmnElement="f_n_62_close_n_62_end"><di:waypoint x="1405" y="235"/><di:waypoint x="1492" y="235"/></bpmndi:BPMNEdge>
