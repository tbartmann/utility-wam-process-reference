<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_15_2" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_15_2" name="15.2 Act on a performance gap" isExecutable="false">
    <documentation>Only 15.2.4 is drawn. 15.2.1, 15.2.2 and 15.2.3 are standing measure definitions: productivity and utilisation, service level and backlog, first-time-fix and rework. EN 15341 names the indicators and SMRP numbers the metrics, and both sets of formulas are behind a paywall or a membership, so the specifications name them and refuse to print the arithmetic. A group whose other three members are definitions has one path in it, and that is the honest picture.

The loop at the end is the point. An improvement action that is never measured is indistinguishable from one that was never taken, so the path closes only after the result is measured, and revises rather than closes when it is not there.</documentation>
    <laneSet id="P_15_2_lanes">
      <lane id="l_152" name="Performance management">
        <flowNodeRef>n_152_sig</flowNodeRef>
        <flowNodeRef>n_152_an</flowNodeRef>
        <flowNodeRef>n_152_pri</flowNodeRef>
        <flowNodeRef>n_152_go</flowNodeRef>
        <flowNodeRef>n_152_park</flowNodeRef>
        <flowNodeRef>n_152_act</flowNodeRef>
        <flowNodeRef>n_152_meas</flowNodeRef>
        <flowNodeRef>n_152_ok</flowNodeRef>
        <flowNodeRef>n_152_rev</flowNodeRef>
        <flowNodeRef>n_152_end</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="n_152_sig" name="Sustained gap or adverse trend"><signalEventDefinition id="n_152_sig_sd"/></startEvent>
    <userTask id="n_152_an" name="Analyse causes and define the opportunity"><documentation>15.2.4. Against a measure whose definition is standing, so the gap is a gap in the world rather than in the arithmetic.</documentation></userTask>
    <userTask id="n_152_pri" name="Prioritise against other candidates"><documentation>15.2.4. No source states the ranking. It is the operator's, and this reference does not supply one.</documentation></userTask>
    <exclusiveGateway id="n_152_go" name="Taken forward"/>
    <endEvent id="n_152_park" name="Recorded and not taken forward"><documentation>15.2.4. Recorded, so the same gap arriving next quarter is visibly the same gap.</documentation></endEvent>
    <userTask id="n_152_act" name="Assign and carry out the approved action"><documentation>15.2.4.</documentation></userTask>
    <serviceTask id="n_152_meas" name="Measure the result on the same definition"><documentation>15.2.4. The same definition. Changing the measure and the process together makes the improvement unprovable.</documentation></serviceTask>
    <exclusiveGateway id="n_152_ok" name="Gap closed"/>
    <userTask id="n_152_rev" name="Revise the action"><documentation>15.2.4.</documentation></userTask>
    <endEvent id="n_152_end" name="Improvement closed"/>
    <sequenceFlow id="f_n_152_sig_n_152_an" sourceRef="n_152_sig" targetRef="n_152_an" name=""/>
    <sequenceFlow id="f_n_152_an_n_152_pri" sourceRef="n_152_an" targetRef="n_152_pri" name=""/>
    <sequenceFlow id="f_n_152_pri_n_152_go" sourceRef="n_152_pri" targetRef="n_152_go" name=""/>
    <sequenceFlow id="f_n_152_go_n_152_park" sourceRef="n_152_go" targetRef="n_152_park" name="not taken forward"><conditionExpression xsi:type="tFormalExpression"><![CDATA[prioritised = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_152_go_n_152_act" sourceRef="n_152_go" targetRef="n_152_act" name="taken forward"/>
    <sequenceFlow id="f_n_152_act_n_152_meas" sourceRef="n_152_act" targetRef="n_152_meas" name=""/>
    <sequenceFlow id="f_n_152_meas_n_152_ok" sourceRef="n_152_meas" targetRef="n_152_ok" name=""/>
    <sequenceFlow id="f_n_152_ok_n_152_rev" sourceRef="n_152_ok" targetRef="n_152_rev" name="not closed"><conditionExpression xsi:type="tFormalExpression"><![CDATA[closed = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_152_rev_n_152_act" sourceRef="n_152_rev" targetRef="n_152_act" name=""/>
    <sequenceFlow id="f_n_152_ok_n_152_end" sourceRef="n_152_ok" targetRef="n_152_end" name="closed"/>
  </process>
  <bpmndi:BPMNDiagram id="dg_P_15_2">
    <bpmndi:BPMNPlane id="pl_P_15_2" bpmnElement="P_15_2">
      <bpmndi:BPMNShape id="sh_n_152_sig" bpmnElement="n_152_sig"><dc:Bounds x="132" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_152_an" bpmnElement="n_152_an"><dc:Bounds x="255" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_152_pri" bpmnElement="n_152_pri"><dc:Bounds x="425" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_152_go" bpmnElement="n_152_go"><dc:Bounds x="637" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_152_park" bpmnElement="n_152_park"><dc:Bounds x="642" y="437" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_152_act" bpmnElement="n_152_act"><dc:Bounds x="765" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_152_meas" bpmnElement="n_152_meas"><dc:Bounds x="935" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_152_ok" bpmnElement="n_152_ok"><dc:Bounds x="1147" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_152_rev" bpmnElement="n_152_rev"><dc:Bounds x="1105" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_152_end" bpmnElement="n_152_end"><dc:Bounds x="1322" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_152_sig_n_152_an" bpmnElement="f_n_152_sig_n_152_an"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_152_an_n_152_pri" bpmnElement="f_n_152_an_n_152_pri"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_152_pri_n_152_go" bpmnElement="f_n_152_pri_n_152_go"><di:waypoint x="555" y="235"/><di:waypoint x="637" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_152_go_n_152_park" bpmnElement="f_n_152_go_n_152_park"><di:waypoint x="683" y="235"/><di:waypoint x="617" y="235"/><di:waypoint x="617" y="455"/><di:waypoint x="642" y="455"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="512.8" y="446.5" width="99.2" height="17" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_152_go_n_152_act" bpmnElement="f_n_152_go_n_152_act"><di:waypoint x="683" y="235"/><di:waypoint x="765" y="235"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="672.5" y="186" width="76.8" height="17" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_152_act_n_152_meas" bpmnElement="f_n_152_act_n_152_meas"><di:waypoint x="895" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_152_meas_n_152_ok" bpmnElement="f_n_152_meas_n_152_ok"><di:waypoint x="1065" y="235"/><di:waypoint x="1147" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_152_ok_n_152_rev" bpmnElement="f_n_152_ok_n_152_rev"><di:waypoint x="1193" y="235"/><di:waypoint x="1080" y="235"/><di:waypoint x="1080" y="455"/><di:waypoint x="1105" y="455"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1015" y="446.5" width="60" height="17" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_152_rev_n_152_act" bpmnElement="f_n_152_rev_n_152_act"><di:waypoint x="1235" y="455"/><di:waypoint x="740" y="455"/><di:waypoint x="740" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_152_ok_n_152_end" bpmnElement="f_n_152_ok_n_152_end"><di:waypoint x="1193" y="235"/><di:waypoint x="1322" y="235"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1237.5" y="213" width="40" height="17" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
