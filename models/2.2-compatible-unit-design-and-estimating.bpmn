      <bpmndi:BPMNShape id="sh_n_22_rel" bpmnElement="n_22_rel"><dc:Bounds x="1785" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_stage" bpmnElement="n_22_stage"><dc:Bounds x="1785" y="90" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_end" bpmnElement="n_22_end"><dc:Bounds x="2002" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_22_start_n_22_loc" bpmnElement="f_n_22_start_n_22_loc"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_loc_n_22_place" bpmnElement="f_n_22_loc_n_22_place"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_place_n_22_line" bpmnElement="f_n_22_place_n_22_line"><di:waypoint x="555" y="235"/><di:waypoint x="400" y="235"/><di:waypoint x="400" y="125"/><di:waypoint x="425" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_line_n_22_recon" bpmnElement="f_n_22_line_n_22_recon"><di:waypoint x="555" y="125"/><di:waypoint x="570" y="125"/><di:waypoint x="570" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
