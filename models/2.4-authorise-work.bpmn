<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_2_4" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_2_4" name="2.4 Authorise work" isExecutable="false">
    <documentation>Tier-4 activities under 2.4.1 and 2.4.3. Approval routing 2.4.2 is a determination and is in 2.4.2-approval-routing.dmn; change to authorised scope 2.4.4 is case-managed and is in 2.4.4-scope-change.cmmn. ISO 21502:2020 cl. 7.7 covers funding and cl. 7.10 covers change control; ISO 55001:2024 cl. 6.3 requires the decision to be traceable to the asset management objectives.</documentation>
    <startEvent id="n_24_start" name="Estimated work requires authorisation"><messageEventDefinition id="n_24_start_md"/></startEvent>
    <userTask id="n_24_src" name="Identify the funding source and charging account"><documentation>2.4.1. The account follows the capitalisation determination made at 2.2.5.</documentation></userTask>
    <serviceTask id="n_24_avail" name="Confirm the amount is available and uncommitted"><documentation>2.4.1. Available is not the same as budgeted; commitment is what makes it real.</documentation></serviceTask>
    <exclusiveGateway id="n_24_fgate" name="Funded"/>
    <userTask id="n_24_hold" name="Hold or refer unfunded work"><documentation>2.4.1 variant. Unfunded work held visibly, not quietly deferred.</documentation></userTask>
    <userTask id="n_24_third" name="Satisfy the external funding condition"><documentation>2.4.1 variant. Reimbursable and contributed-capital work carries conditions that must be satisfied before commitment.</documentation></userTask>
    <serviceTask id="n_24_commit" name="Commit the funds against the work"><documentation>2.4.1.</documentation></serviceTask>
    <businessRuleTask id="n_24_route" name="Determine the approval authority"><documentation>2.4.2. Calls decision Approval_routing in 2.4.2-approval-routing.dmn.</documentation></businessRuleTask>
    <sendTask id="n_24_send" name="Route to the determined authority"><documentation>2.4.2.</documentation></sendTask>
    <receiveTask id="n_24_dec" name="Receive the decision and its rationale"><documentation>2.4.2. The rationale is recorded whether the decision is to approve or not; a decline with no reason recurs as the same submission.</documentation></receiveTask>
    <exclusiveGateway id="n_24_gate" name="Decision"/>
    <userTask id="n_24_esc" name="Escalate or resubmit"><documentation>2.4.2. Declined or deferred work goes back with what changed, not unchanged.</documentation></userTask>
    <serviceTask id="n_24_check" name="Confirm approval, funding and design release"><documentation>2.4.3. All three, or the release is conditional and must say so.</documentation></serviceTask>
    <serviceTask id="n_24_base" name="Record the authorised scope, cost and date basis"><documentation>2.4.3. This is the baseline every later variance is measured against, and the baseline 2.4.4 controls change to.</documentation></serviceTask>
    <sendTask id="n_24_rel" name="Release the work to planning and scheduling"><documentation>2.4.3.</documentation></sendTask>
    <endEvent id="n_24_end" name="Work authorised at a fixed baseline"/>
    <endEvent id="n_24_endh" name="Held unfunded"/>
    <sequenceFlow id="f_n_24_start_n_24_src" sourceRef="n_24_start" targetRef="n_24_src" name=""/>
    <sequenceFlow id="f_n_24_src_n_24_avail" sourceRef="n_24_src" targetRef="n_24_avail" name=""/>
    <sequenceFlow id="f_n_24_avail_n_24_fgate" sourceRef="n_24_avail" targetRef="n_24_fgate" name=""/>
    <sequenceFlow id="f_n_24_fgate_n_24_hold" sourceRef="n_24_fgate" targetRef="n_24_hold" name="not funded"><conditionExpression xsi:type="tFormalExpression"><![CDATA[fundingAvailable = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_24_hold_n_24_endh" sourceRef="n_24_hold" targetRef="n_24_endh" name=""/>
    <sequenceFlow id="f_n_24_fgate_n_24_third" sourceRef="n_24_fgate" targetRef="n_24_third" name="external funding condition"><conditionExpression xsi:type="tFormalExpression"><![CDATA[fundingSource = "thirdParty"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_24_third_n_24_commit" sourceRef="n_24_third" targetRef="n_24_commit" name=""/>
    <sequenceFlow id="f_n_24_fgate_n_24_commit" sourceRef="n_24_fgate" targetRef="n_24_commit" name="funded"/>
    <sequenceFlow id="f_n_24_commit_n_24_route" sourceRef="n_24_commit" targetRef="n_24_route" name=""/>
    <sequenceFlow id="f_n_24_route_n_24_send" sourceRef="n_24_route" targetRef="n_24_send" name=""/>
    <sequenceFlow id="f_n_24_send_n_24_dec" sourceRef="n_24_send" targetRef="n_24_dec" name=""/>
    <sequenceFlow id="f_n_24_dec_n_24_gate" sourceRef="n_24_dec" targetRef="n_24_gate" name=""/>
    <sequenceFlow id="f_n_24_gate_n_24_esc" sourceRef="n_24_gate" targetRef="n_24_esc" name="declined or deferred"><conditionExpression xsi:type="tFormalExpression"><![CDATA[approvalDecision != "approved"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_24_esc_n_24_route" sourceRef="n_24_esc" targetRef="n_24_route" name="resubmitted"/>
    <sequenceFlow id="f_n_24_gate_n_24_check" sourceRef="n_24_gate" targetRef="n_24_check" name="approved"/>
    <sequenceFlow id="f_n_24_check_n_24_base" sourceRef="n_24_check" targetRef="n_24_base" name=""/>
    <sequenceFlow id="f_n_24_base_n_24_rel" sourceRef="n_24_base" targetRef="n_24_rel" name=""/>
    <sequenceFlow id="f_n_24_rel_n_24_end" sourceRef="n_24_rel" targetRef="n_24_end" name=""/>
  </process>
  <bpmndi:BPMNDiagram id="dg_P_2_4">
    <bpmndi:BPMNPlane id="pl_P_2_4" bpmnElement="P_2_4">
      <bpmndi:BPMNShape id="sh_n_24_start" bpmnElement="n_24_start"><dc:Bounds x="132" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_src" bpmnElement="n_24_src"><dc:Bounds x="255" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_avail" bpmnElement="n_24_avail"><dc:Bounds x="425" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_fgate" bpmnElement="n_24_fgate"><dc:Bounds x="637" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_hold" bpmnElement="n_24_hold"><dc:Bounds x="595" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_third" bpmnElement="n_24_third"><dc:Bounds x="595" y="90" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_commit" bpmnElement="n_24_commit"><dc:Bounds x="765" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_route" bpmnElement="n_24_route"><dc:Bounds x="935" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_send" bpmnElement="n_24_send"><dc:Bounds x="1105" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_dec" bpmnElement="n_24_dec"><dc:Bounds x="1275" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_gate" bpmnElement="n_24_gate"><dc:Bounds x="1487" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_esc" bpmnElement="n_24_esc"><dc:Bounds x="1445" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_check" bpmnElement="n_24_check"><dc:Bounds x="1615" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_base" bpmnElement="n_24_base"><dc:Bounds x="1785" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_rel" bpmnElement="n_24_rel"><dc:Bounds x="1955" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_end" bpmnElement="n_24_end"><dc:Bounds x="2172" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_endh" bpmnElement="n_24_endh"><dc:Bounds x="812" y="437" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_24_start_n_24_src" bpmnElement="f_n_24_start_n_24_src"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_src_n_24_avail" bpmnElement="f_n_24_src_n_24_avail"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_avail_n_24_fgate" bpmnElement="f_n_24_avail_n_24_fgate"><di:waypoint x="555" y="235"/><di:waypoint x="637" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_fgate_n_24_hold" bpmnElement="f_n_24_fgate_n_24_hold"><di:waypoint x="683" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="455"/><di:waypoint x="595" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_hold_n_24_endh" bpmnElement="f_n_24_hold_n_24_endh"><di:waypoint x="725" y="455"/><di:waypoint x="812" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_fgate_n_24_third" bpmnElement="f_n_24_fgate_n_24_third"><di:waypoint x="683" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="125"/><di:waypoint x="595" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_third_n_24_commit" bpmnElement="f_n_24_third_n_24_commit"><di:waypoint x="725" y="125"/><di:waypoint x="740" y="125"/><di:waypoint x="740" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_fgate_n_24_commit" bpmnElement="f_n_24_fgate_n_24_commit"><di:waypoint x="683" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_commit_n_24_route" bpmnElement="f_n_24_commit_n_24_route"><di:waypoint x="895" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_route_n_24_send" bpmnElement="f_n_24_route_n_24_send"><di:waypoint x="1065" y="235"/><di:waypoint x="1105" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_send_n_24_dec" bpmnElement="f_n_24_send_n_24_dec"><di:waypoint x="1235" y="235"/><di:waypoint x="1275" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_dec_n_24_gate" bpmnElement="f_n_24_dec_n_24_gate"><di:waypoint x="1405" y="235"/><di:waypoint x="1487" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_gate_n_24_esc" bpmnElement="f_n_24_gate_n_24_esc"><di:waypoint x="1533" y="235"/><di:waypoint x="1420" y="235"/><di:waypoint x="1420" y="455"/><di:waypoint x="1445" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_esc_n_24_route" bpmnElement="f_n_24_esc_n_24_route"><di:waypoint x="1575" y="455"/><di:waypoint x="910" y="455"/><di:waypoint x="910" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_gate_n_24_check" bpmnElement="f_n_24_gate_n_24_check"><di:waypoint x="1533" y="235"/><di:waypoint x="1615" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_check_n_24_base" bpmnElement="f_n_24_check_n_24_base"><di:waypoint x="1745" y="235"/><di:waypoint x="1785" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_base_n_24_rel" bpmnElement="f_n_24_base_n_24_rel"><di:waypoint x="1915" y="235"/><di:waypoint x="1955" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_rel_n_24_end" bpmnElement="f_n_24_rel_n_24_end"><di:waypoint x="2085" y="235"/><di:waypoint x="2172" y="235"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
