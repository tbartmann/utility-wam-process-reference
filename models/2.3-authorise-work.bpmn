      <bpmndi:BPMNShape id="sh_n_23_base" bpmnElement="n_23_base"><dc:Bounds x="1785" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_rel" bpmnElement="n_23_rel"><dc:Bounds x="1955" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_end" bpmnElement="n_23_end"><dc:Bounds x="2172" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_endh" bpmnElement="n_23_endh"><dc:Bounds x="812" y="437" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_23_start_n_23_src" bpmnElement="f_n_23_start_n_23_src"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_src_n_23_avail" bpmnElement="f_n_23_src_n_23_avail"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_avail_n_23_fgate" bpmnElement="f_n_23_avail_n_23_fgate"><di:waypoint x="555" y="235"/><di:waypoint x="637" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_fgate_n_23_hold" bpmnElement="f_n_23_fgate_n_23_hold"><di:waypoint x="683" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="455"/><di:waypoint x="595" y="455"/>
