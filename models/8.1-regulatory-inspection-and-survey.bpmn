      <bpmndi:BPMNShape id="sh_n_81_atm" bpmnElement="n_81_atm"><dc:Bounds x="935" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_81_find" bpmnElement="n_81_find"><dc:Bounds x="1105" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_81_any" bpmnElement="n_81_any"><dc:Bounds x="1317" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_81_raise" bpmnElement="n_81_raise"><dc:Bounds x="1275" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_81_date" bpmnElement="n_81_date"><dc:Bounds x="1445" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_81_hand" bpmnElement="n_81_hand"><dc:Bounds x="1615" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_81_end" bpmnElement="n_81_end"><dc:Bounds x="1832" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_81_start_n_81_pop" bpmnElement="f_n_81_start_n_81_pop"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_81_pop_n_81_reg" bpmnElement="f_n_81_pop_n_81_reg"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_81_reg_n_81_gas" bpmnElement="f_n_81_reg_n_81_gas"><di:waypoint x="513" y="235"/><di:waypoint x="400" y="235"/><di:waypoint x="400" y="455"/><di:waypoint x="425" y="455"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="355" y="446.5" width="40" height="17" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_81_reg_n_81_ele" bpmnElement="f_n_81_reg_n_81_ele"><di:waypoint x="513" y="235"/><di:waypoint x="400" y="235"/><di:waypoint x="400" y="675"/><di:waypoint x="425" y="675"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="346.2" y="666.5" width="48.8" height="17" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_81_gas_n_81_rel" bpmnElement="f_n_81_gas_n_81_rel"><di:waypoint x="555" y="455"/><di:waypoint x="570" y="455"/><di:waypoint x="570" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
