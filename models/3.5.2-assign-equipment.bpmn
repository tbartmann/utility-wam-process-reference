      <bpmndi:BPMNShape id="sh_n_352_rec" bpmnElement="n_352_rec"><dc:Bounds x="935" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_352_down" bpmnElement="n_352_down"><dc:Bounds x="1105" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_352_pub" bpmnElement="n_352_pub"><dc:Bounds x="1275" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_352_end" bpmnElement="n_352_end"><dc:Bounds x="1492" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_352_start_n_352_need" bpmnElement="f_n_352_start_n_352_need"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_need_n_352_pool" bpmnElement="f_n_352_need_n_352_pool"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_pool_n_352_gate" bpmnElement="f_n_352_pool_n_352_gate"><di:waypoint x="555" y="235"/><di:waypoint x="637" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_gate_n_352_ded" bpmnElement="f_n_352_gate_n_352_ded"><di:waypoint x="683" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="125"/><di:waypoint x="595" y="125"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="465.8" y="110" width="99.2" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
