<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="Approval_routing" name="2.4.2 Approval routing" namespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <description>Called from 2.4-authorise-work.bpmn as a business rule task. The output is an authority, not a state change. Delegation thresholds are the operator's and change on their own cycle; the structure of the determination does not. Thresholds are therefore expressed as named bands, never as figures in the reference.</description>
  <inputData id="in_estimatedValue" name="Estimated value band"><variable id="in_estimatedValue_v" name="Estimated value band" typeRef="string"/></inputData>
  <inputData id="in_workType" name="Work type"><variable id="in_workType_v" name="Work type" typeRef="string"/></inputData>
  <inputData id="in_riskProfile" name="Risk profile"><variable id="in_riskProfile_v" name="Risk profile" typeRef="string"/></inputData>
  <inputData id="in_fundingSource" name="Funding source"><variable id="in_fundingSource_v" name="Funding source" typeRef="string"/></inputData>
  <inputData id="in_regulatoryCommitment" name="Regulatory commitment"><variable id="in_regulatoryCommitment_v" name="Regulatory commitment" typeRef="boolean"/></inputData>
  <knowledgeSource id="ks_iso21502" name="ISO 21502:2020 cl. 7.7 and ISO 55001:2024 cl. 6.3"><description>Funding and financial control, and the requirement that decisions be traceable to the asset management objectives. Neither standard sets thresholds; they require that an authority exists and that the decision is recorded.</description></knowledgeSource>
  <decision id="d_2_4_2" name="Approval routing">
    <description>2.4.2. Bands, not figures: an operator's delegation schedule is a specialization overlay keyed on this decision's uid, and the reference table stays valid when the schedule changes.</description>
    <variable id="d_2_4_2_v" name="Approval routing" typeRef="string"/>
    <informationRequirement id="ir_d_2_4_2_in_regulatoryCommitment"><requiredInput href="#in_regulatoryCommitment"/></informationRequirement>
    <informationRequirement id="ir_d_2_4_2_in_workType"><requiredInput href="#in_workType"/></informationRequirement>
    <informationRequirement id="ir_d_2_4_2_in_estimatedValue"><requiredInput href="#in_estimatedValue"/></informationRequirement>
    <informationRequirement id="ir_d_2_4_2_in_riskProfile"><requiredInput href="#in_riskProfile"/></informationRequirement>
    <informationRequirement id="ir_d_2_4_2_in_fundingSource"><requiredInput href="#in_fundingSource"/></informationRequirement>
    <authorityRequirement id="ar_d_2_4_2"><requiredAuthority href="#ks_iso21502"/></authorityRequirement>
    <decisionTable id="d_2_4_2_dt" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="d_2_4_2_i1" label="Regulatory commitment"><inputExpression id="d_2_4_2_i1_e" typeRef="boolean"><text>in_regulatoryCommitment</text></inputExpression></input>
      <input id="d_2_4_2_i2" label="Work type"><inputExpression id="d_2_4_2_i2_e" typeRef="string"><text>in_workType</text></inputExpression></input>
      <input id="d_2_4_2_i3" label="Estimated value band"><inputExpression id="d_2_4_2_i3_e" typeRef="string"><text>in_estimatedValue</text></inputExpression></input>
      <input id="d_2_4_2_i4" label="Risk profile"><inputExpression id="d_2_4_2_i4_e" typeRef="string"><text>in_riskProfile</text></inputExpression></input>
      <input id="d_2_4_2_i5" label="Funding source"><inputExpression id="d_2_4_2_i5_e" typeRef="string"><text>in_fundingSource</text></inputExpression></input>
      <output id="d_2_4_2_o" label="Approval routing" name="Approval routing" typeRef="string"/>
      <rule id="d_2_4_2_r1">
        <description>External funding carries its own approval, which is additional to the internal authority, not a substitute for it.</description>
        <inputEntry id="d_2_4_2_r1_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r1_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r1_ie3"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r1_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r1_ie5"><text>"thirdParty","grant"</text></inputEntry>
        <outputEntry id="d_2_4_2_r1_oe"><text>"externalFunder"</text></outputEntry>
      </rule>
      <rule id="d_2_4_2_r2">
        <description>Work discharging a regulatory commitment is routed to the accountable compliance owner regardless of value.</description>
        <inputEntry id="d_2_4_2_r2_ie1"><text>true</text></inputEntry>
        <inputEntry id="d_2_4_2_r2_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r2_ie3"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r2_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r2_ie5"><text>-</text></inputEntry>
        <outputEntry id="d_2_4_2_r2_oe"><text>"regulatoryOwner"</text></outputEntry>
      </rule>
      <rule id="d_2_4_2_r3">
        <description>Type-based authority. Value is the wrong test for safety-critical work.</description>
        <inputEntry id="d_2_4_2_r3_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r3_ie2"><text>"safetyCritical","integrity"</text></inputEntry>
        <inputEntry id="d_2_4_2_r3_ie3"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r3_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r3_ie5"><text>-</text></inputEntry>
        <outputEntry id="d_2_4_2_r3_oe"><text>"engineeringAuthority"</text></outputEntry>
      </rule>
      <rule id="d_2_4_2_r4">
        <description>Above the committee threshold, whatever the operator has set it at.</description>
        <inputEntry id="d_2_4_2_r4_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r4_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r4_ie3"><text>"aboveCommitteeThreshold"</text></inputEntry>
        <inputEntry id="d_2_4_2_r4_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r4_ie5"><text>-</text></inputEntry>
        <outputEntry id="d_2_4_2_r4_oe"><text>"investmentCommittee"</text></outputEntry>
      </rule>
      <rule id="d_2_4_2_r5">
        <inputEntry id="d_2_4_2_r5_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r5_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r5_ie3"><text>"aboveDelegatedLimit"</text></inputEntry>
        <inputEntry id="d_2_4_2_r5_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r5_ie5"><text>-</text></inputEntry>
        <outputEntry id="d_2_4_2_r5_oe"><text>"seniorDelegate"</text></outputEntry>
      </rule>
      <rule id="d_2_4_2_r6">
        <description>Within the value limit but not within the risk appetite. Risk escalates the authority even where value does not.</description>
        <inputEntry id="d_2_4_2_r6_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r6_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r6_ie3"><text>"withinDelegatedLimit"</text></inputEntry>
        <inputEntry id="d_2_4_2_r6_ie4"><text>"high","complex"</text></inputEntry>
        <inputEntry id="d_2_4_2_r6_ie5"><text>-</text></inputEntry>
        <outputEntry id="d_2_4_2_r6_oe"><text>"seniorDelegate"</text></outputEntry>
      </rule>
      <rule id="d_2_4_2_r7">
        <inputEntry id="d_2_4_2_r7_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r7_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r7_ie3"><text>"withinDelegatedLimit"</text></inputEntry>
        <inputEntry id="d_2_4_2_r7_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r7_ie5"><text>-</text></inputEntry>
        <outputEntry id="d_2_4_2_r7_oe"><text>"delegatedApprover"</text></outputEntry>
      </rule>
      <rule id="d_2_4_2_r8">
        <description>Unroutable work is held. An unroutable case usually means the value band or the work type is missing, which is a data problem.</description>
        <inputEntry id="d_2_4_2_r8_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r8_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r8_ie3"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r8_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_4_2_r8_ie5"><text>-</text></inputEntry>
        <outputEntry id="d_2_4_2_r8_oe"><text>"determineManually"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="drd_Approval_routing">
      <dmndi:DMNShape id="sh_in_estimatedValue" dmnElementRef="in_estimatedValue"><dc:Bounds x="60" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_in_workType" dmnElementRef="in_workType"><dc:Bounds x="245" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_in_riskProfile" dmnElementRef="in_riskProfile"><dc:Bounds x="430" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_in_fundingSource" dmnElementRef="in_fundingSource"><dc:Bounds x="615" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_in_regulatoryCommitment" dmnElementRef="in_regulatoryCommitment"><dc:Bounds x="800" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_d_2_4_2" dmnElementRef="d_2_4_2"><dc:Bounds x="60" y="240" width="180" height="70"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_ks_iso21502" dmnElementRef="ks_iso21502"><dc:Bounds x="900" y="100" width="160" height="55"/></dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
