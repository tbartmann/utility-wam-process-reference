      <bpmndi:BPMNShape id="sh_n_191_clr" bpmnElement="n_191_clr"><dc:Bounds x="935" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_191_rel" bpmnElement="n_191_rel"><dc:Bounds x="1105" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_191_en" bpmnElement="n_191_en"><dc:Bounds x="1275" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_191_ok" bpmnElement="n_191_ok"><dc:Bounds x="1487" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_191_dump" bpmnElement="n_191_dump"><dc:Bounds x="1445" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_191_recd" bpmnElement="n_191_recd"><dc:Bounds x="1615" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_191_hand" bpmnElement="n_191_hand"><dc:Bounds x="1785" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_191_rl" bpmnElement="n_191_rl"><dc:Bounds x="1955" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_191_tell" bpmnElement="n_191_tell"><dc:Bounds x="2125" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_191_end" bpmnElement="n_191_end"><dc:Bounds x="2342" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_191_start_n_191_ev" bpmnElement="f_n_191_start_n_191_ev"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_191_ev_n_191_acc" bpmnElement="f_n_191_ev_n_191_acc"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
