      <bpmndi:BPMNShape id="sh_n_105_end" bpmnElement="n_105_end"><dc:Bounds x="2682" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_105_start_n_105_find" bpmnElement="f_n_105_start_n_105_find"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_find_n_105_ver" bpmnElement="f_n_105_find_n_105_ver"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_ver_n_105_vg" bpmnElement="f_n_105_ver_n_105_vg"><di:waypoint x="555" y="235"/><di:waypoint x="637" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_vg_n_105_exc" bpmnElement="f_n_105_vg_n_105_exc"><di:waypoint x="683" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="455"/><di:waypoint x="595" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_exc_n_105_ver" bpmnElement="f_n_105_exc_n_105_ver"><di:waypoint x="725" y="455"/><di:waypoint x="400" y="455"/><di:waypoint x="400" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_vg_n_105_cred" bpmnElement="f_n_105_vg_n_105_cred"><di:waypoint x="683" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_cred_n_105_cg" bpmnElement="f_n_105_cred_n_105_cg"><di:waypoint x="895" y="235"/><di:waypoint x="977" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_cg_n_105_chold" bpmnElement="f_n_105_cg_n_105_chold"><di:waypoint x="1023" y="235"/><di:waypoint x="910" y="235"/><di:waypoint x="910" y="455"/><di:waypoint x="935" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_chold_n_105_cg" bpmnElement="f_n_105_chold_n_105_cg"><di:waypoint x="1065" y="455"/><di:waypoint x="952" y="455"/><di:waypoint x="952" y="235"/><di:waypoint x="977" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_cg_n_105_kind" bpmnElement="f_n_105_cg_n_105_kind"><di:waypoint x="1023" y="235"/><di:waypoint x="1147" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_kind_n_105_pair" bpmnElement="f_n_105_kind_n_105_pair"><di:waypoint x="1193" y="235"/><di:waypoint x="1250" y="235"/><di:waypoint x="1250" y="455"/><di:waypoint x="1275" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_kind_n_105_one" bpmnElement="f_n_105_kind_n_105_one"><di:waypoint x="1193" y="235"/><di:waypoint x="1275" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_pair_n_105_read" bpmnElement="f_n_105_pair_n_105_read"><di:waypoint x="1405" y="455"/><di:waypoint x="1420" y="455"/><di:waypoint x="1420" y="235"/><di:waypoint x="1445" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_105_one_n_105_read" bpmnElement="f_n_105_one_n_105_read"><di:waypoint x="1405" y="235"/><di:waypoint x="1445" y="235"/></bpmndi:BPMNEdge>
