      <bpmndi:BPMNShape id="sh_n_181_gas" bpmnElement="n_181_gas"><dc:Bounds x="595" y="411.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_181_val" bpmnElement="n_181_val"><dc:Bounds x="765" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_181_imp" bpmnElement="n_181_imp"><dc:Bounds x="935" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_181_ver" bpmnElement="n_181_ver"><dc:Bounds x="1105" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_181_ok" bpmnElement="n_181_ok"><dc:Bounds x="1317" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_181_back" bpmnElement="n_181_back"><dc:Bounds x="1275" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_181_cont" bpmnElement="n_181_cont"><dc:Bounds x="1445" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_181_end" bpmnElement="n_181_end"><dc:Bounds x="1662" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_181_start_n_181_reg" bpmnElement="f_n_181_start_n_181_reg"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_181_reg_n_181_gw" bpmnElement="f_n_181_reg_n_181_gw"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_181_gw_n_181_none" bpmnElement="f_n_181_gw_n_181_none"><di:waypoint x="513" y="235"/><di:waypoint x="447" y="235"/><di:waypoint x="447" y="675"/><di:waypoint x="472" y="675"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="370.8" y="666.5" width="71.2" height="17" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_181_gw_n_181_points" bpmnElement="f_n_181_gw_n_181_points"><di:waypoint x="513" y="235"/><di:waypoint x="595" y="235"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="521.2" y="200" width="65.6" height="30" />
