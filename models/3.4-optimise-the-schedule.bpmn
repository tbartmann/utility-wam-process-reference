<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_3_4" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_3_4" name="3.4 Optimise the schedule" isExecutable="false">
    <documentation>Tier-4 activities under 3.4.1 and 3.4.4. Constraint binding is in 3.4.3-apply-constraints.dmn; exceptions and overrides are case-managed in 3.4.5-schedule-exceptions.cmmn; travel routing 3.4.2 is specified and deliberately not drawn, because the algorithm is vendor-defined. Note what this group does NOT do: it publishes a schedule change, it does not dispatch. Dispatch is 4.1.</documentation>
    <startEvent id="n_34_start" name="Work released as ready to schedule"><messageEventDefinition id="n_34_start_md"/></startEvent>
    <businessRuleTask id="n_34_bind" name="Bind the constraint set"><documentation>3.4.3. Calls decision Schedule_constraints in 3.4.3-apply-constraints.dmn. Statutory dates, qualification, customer windows and approved outage windows.</documentation></businessRuleTask>
    <serviceTask id="n_34_match" name="Match skill, qualification, location and priority"><documentation>3.4.1.</documentation></serviceTask>
    <exclusiveGateway id="n_34_gate" name="Match found"/>
    <serviceTask id="n_34_hold" name="Leave in the ready bank with the reason"><documentation>3.4.1. With the reason - an unmatched item with no reason is indistinguishable from an item nobody looked at.</documentation></serviceTask>
    <callActivity id="n_34_ex" name="Handle as an exception or override"><documentation>3.4.5. Case-managed; see 3.4.5-schedule-exceptions.cmmn.</documentation></callActivity>
    <serviceTask id="n_34_place" name="Place on a crew and a WorkTimeSchedule"><documentation>3.4.1. Internal crew, or a contracted crew already on the roster.</documentation></serviceTask>
    <callActivity id="n_34_route" name="Order the day for travel"><documentation>3.4.2. Specified, not drawn - the routing algorithm is vendor-defined. It may return no safe order, which sends the work back to 3.4.1.</documentation></callActivity>
    <sendTask id="n_34_pub" name="Publish the schedule"><documentation>3.4.1.</documentation></sendTask>
    <endEvent id="n_34_end" name="Work scheduled"/>
    <startEvent id="n_34_dstart" name="Emergent work or a disruption has invalidated part of the schedule"><messageEventDefinition id="n_34_dstart_md"/></startEvent>
    <serviceTask id="n_34_hit" name="Identify the work and crews the disruption has hit"><documentation>3.4.4.</documentation></serviceTask>
    <serviceTask id="n_34_prot" name="Protect compliance-dated and in-progress work"><documentation>3.4.4. Protected first, before anything is re-placed. A compliance date does not move because the day did.</documentation></serviceTask>
    <exclusiveGateway id="n_34_major" name="Still a day's rebuild"/>
    <sendTask id="n_34_hand" name="Hand to major event management"><documentation>3.4.4. When it is no longer a day's rebuild it belongs to 9.4, not here.</documentation></sendTask>
    <serviceTask id="n_34_re" name="Place the emergent item and re-place what it displaced"><documentation>3.4.4.</documentation></serviceTask>
    <sendTask id="n_34_pub2" name="Publish the change to dispatch"><documentation>3.4.4. Publish, not dispatch. Dispatch is 4.1 and the distinction is deliberate.</documentation></sendTask>
    <endEvent id="n_34_dend" name="Schedule rebuilt"/>
    <endEvent id="n_34_hend" name="Handed to major event management"/>
    <sequenceFlow id="f_n_34_start_n_34_bind" sourceRef="n_34_start" targetRef="n_34_bind" name=""/>
    <sequenceFlow id="f_n_34_bind_n_34_match" sourceRef="n_34_bind" targetRef="n_34_match" name=""/>
    <sequenceFlow id="f_n_34_match_n_34_gate" sourceRef="n_34_match" targetRef="n_34_gate" name=""/>
    <sequenceFlow id="f_n_34_gate_n_34_hold" sourceRef="n_34_gate" targetRef="n_34_hold" name="no match"><conditionExpression xsi:type="tFormalExpression"><![CDATA[matchFound = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_34_hold_n_34_ex" sourceRef="n_34_hold" targetRef="n_34_ex" name=""/>
    <sequenceFlow id="f_n_34_ex_n_34_match" sourceRef="n_34_ex" targetRef="n_34_match" name="returned to matching"/>
    <sequenceFlow id="f_n_34_gate_n_34_place" sourceRef="n_34_gate" targetRef="n_34_place" name="matched"/>
    <sequenceFlow id="f_n_34_place_n_34_route" sourceRef="n_34_place" targetRef="n_34_route" name=""/>
    <sequenceFlow id="f_n_34_route_n_34_match" sourceRef="n_34_route" targetRef="n_34_match" name="no safe order"><conditionExpression xsi:type="tFormalExpression"><![CDATA[routable = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_34_route_n_34_pub" sourceRef="n_34_route" targetRef="n_34_pub" name="ordered"/>
    <sequenceFlow id="f_n_34_pub_n_34_end" sourceRef="n_34_pub" targetRef="n_34_end" name=""/>
    <sequenceFlow id="f_n_34_dstart_n_34_hit" sourceRef="n_34_dstart" targetRef="n_34_hit" name=""/>
    <sequenceFlow id="f_n_34_hit_n_34_prot" sourceRef="n_34_hit" targetRef="n_34_prot" name=""/>
    <sequenceFlow id="f_n_34_prot_n_34_major" sourceRef="n_34_prot" targetRef="n_34_major" name=""/>
    <sequenceFlow id="f_n_34_major_n_34_hand" sourceRef="n_34_major" targetRef="n_34_hand" name="beyond a day's rebuild"><conditionExpression xsi:type="tFormalExpression"><![CDATA[disruptionScale = "majorEvent"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_34_hand_n_34_hend" sourceRef="n_34_hand" targetRef="n_34_hend" name=""/>
    <sequenceFlow id="f_n_34_major_n_34_re" sourceRef="n_34_major" targetRef="n_34_re" name="a day's rebuild"/>
    <sequenceFlow id="f_n_34_re_n_34_pub2" sourceRef="n_34_re" targetRef="n_34_pub2" name=""/>
    <sequenceFlow id="f_n_34_pub2_n_34_dend" sourceRef="n_34_pub2" targetRef="n_34_dend" name=""/>
  </process>
