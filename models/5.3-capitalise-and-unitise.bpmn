      <bpmndi:BPMNShape id="sh_n_53_rec" bpmnElement="n_53_rec"><dc:Bounds x="1785" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_pj" bpmnElement="n_53_pj"><dc:Bounds x="1997" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_var" bpmnElement="n_53_var"><dc:Bounds x="1955" y="81.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_close" bpmnElement="n_53_close"><dc:Bounds x="2125" y="90" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_53_end" bpmnElement="n_53_end"><dc:Bounds x="2342" y="217" width="36" height="36"/></bpmndi:BPMNShape>
