      <bpmndi:BPMNEdge id="ed_f_n_122_match_n_122_cmp" bpmnElement="f_n_122_match_n_122_cmp"><di:waypoint x="555" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_122_cmp_n_122_gw" bpmnElement="f_n_122_cmp_n_122_gw"><di:waypoint x="725" y="235"/><di:waypoint x="807" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_122_gw_n_122_case" bpmnElement="f_n_122_gw_n_122_case"><di:waypoint x="853" y="235"/><di:waypoint x="740" y="235"/><di:waypoint x="740" y="455"/><di:waypoint x="765" y="455"/></bpmndi:BPMNEdge>
