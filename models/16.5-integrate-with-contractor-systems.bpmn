      <bpmndi:BPMNShape id="sh_n_165_hand" bpmnElement="n_165_hand"><dc:Bounds x="595" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_165_u" bpmnElement="n_165_u"><dc:Bounds x="132" y="1097" width="36" height="36"/></bpmndi:BPMNShape>
