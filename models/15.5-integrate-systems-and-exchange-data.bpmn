      <bpmndi:BPMNEdge id="ed_f_n_155_start_n_155_kind" bpmnElement="f_n_155_start_n_155_kind"><di:waypoint x="168" y="235"/><di:waypoint x="297" y="235"/></bpmndi:BPMNEdge>
