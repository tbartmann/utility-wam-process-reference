      <bpmndi:BPMNEdge id="ed_f_n_153_r_n_153_cls" bpmnElement="f_n_153_r_n_153_cls"><di:waypoint x="168" y="1115"/><di:waypoint x="255" y="1115"/></bpmndi:BPMNEdge>
