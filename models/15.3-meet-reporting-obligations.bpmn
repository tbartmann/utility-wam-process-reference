      <bpmndi:BPMNEdge id="ed_f_n_153_app_n_153_sub" bpmnElement="f_n_153_app_n_153_sub"><di:waypoint x="725" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_153_sub_n_153_ack" bpmnElement="f_n_153_sub_n_153_ack"><di:waypoint x="895" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
