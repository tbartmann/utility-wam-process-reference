      <bpmndi:BPMNShape id="sh_n_124_pop" bpmnElement="n_124_pop"><dc:Bounds x="255" y="631.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_124_asm" bpmnElement="n_124_asm"><dc:Bounds x="425" y="631.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_124_calc" bpmnElement="n_124_calc"><dc:Bounds x="595" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_124_route" bpmnElement="n_124_route"><dc:Bounds x="765" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_124_e2" bpmnElement="n_124_e2"><dc:Bounds x="982" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_124_t_n_124_scope" bpmnElement="f_n_124_t_n_124_scope"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_124_scope_n_124_meth" bpmnElement="f_n_124_scope_n_124_meth"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
