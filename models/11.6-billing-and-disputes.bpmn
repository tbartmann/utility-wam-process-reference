<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_11_6" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_11_6" name="11.6 Bill, settle and resolve attachment disputes" isExecutable="false">
    <documentation>11.6.1 to 11.6.4 are drawn; the unauthorised-attachment charge is decided at 11.6.5 and disputes are a case at 11.6.6. The ceiling test belongs inside the calculation and not in a review afterwards, because 47 CFR 1.1407(a)(3) lets the Commission order a refund WITH INTEREST of anything charged above it. And 47 CFR 1.1404(f) obliges you to hand over the supporting regulatory-report pages and the calculations within 30 days of a reasonable request - so a rate you cannot produce the basis for is a rate you cannot defend, and the basis is retained as the calculation is made rather than reconstructed later.</documentation>
    <laneSet id="P_11_6_lanes">
      <lane id="l_116_fin" name="Billing and settlement">
        <flowNodeRef>n_116_t</flowNodeRef>
        <flowNodeRef>n_116_cnt</flowNodeRef>
        <flowNodeRef>n_116_calc</flowNodeRef>
        <flowNodeRef>n_116_cg</flowNodeRef>
        <flowNodeRef>n_116_fix</flowNodeRef>
        <flowNodeRef>n_116_keep</flowNodeRef>
        <flowNodeRef>n_116_rg</flowNodeRef>
        <flowNodeRef>n_116_inv</flowNodeRef>
        <flowNodeRef>n_116_age</flowNodeRef>
        <flowNodeRef>n_116_end</flowNodeRef>
        <flowNodeRef>n_116_s</flowNodeRef>
        <flowNodeRef>n_116_pos</flowNodeRef>
        <flowNodeRef>n_116_net</flowNodeRef>
        <flowNodeRef>n_116_send</flowNodeRef>
        <flowNodeRef>n_116_p</flowNodeRef>
        <flowNodeRef>n_116_pay</flowNodeRef>
        <flowNodeRef>n_116_pend</flowNodeRef>
      </lane>
      <lane id="l_116_ju" name="Joint use administration">
        <flowNodeRef>n_116_not</flowNodeRef>
        <flowNodeRef>n_116_ex</flowNodeRef>
        <flowNodeRef>n_116_dg</flowNodeRef>
        <flowNodeRef>n_116_hold</flowNodeRef>
        <flowNodeRef>n_116_ver</flowNodeRef>
        <flowNodeRef>n_116_pg</flowNodeRef>
        <flowNodeRef>n_116_dis</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="n_116_t" name="Billing period closed"><timerEventDefinition id="n_116_t_td"/></startEvent>
    <serviceTask id="n_116_cnt" name="Take the billable count at a stated date"><documentation>11.6.1. A dated count, not an average, unless the agreement says otherwise - an undated count cannot be reconciled to an audit.</documentation></serviceTask>
    <serviceTask id="n_116_calc" name="Calculate rental on the rate from 11.1.3"><documentation>11.6.1.</documentation></serviceTask>
    <exclusiveGateway id="n_116_cg" name="Within the ceiling"/>
    <userTask id="n_116_fix" name="Recalculate to the ceiling"><documentation>11.6.1. Above 1.1406(d) is recoverable from you under 1.1407(a)(3), with interest.</documentation></userTask>
    <serviceTask id="n_116_keep" name="Retain the basis with the calculation"><documentation>11.6.1. 1.1404(f) gives you 30 days to produce it on request.</documentation></serviceTask>
    <exclusiveGateway id="n_116_rg" name="Rate increasing"/>
    <sendTask id="n_116_not" name="Give 60 days written notice"><documentation>11.6.2. 1.1403(c). Billing an increase without it does not make it effective.</documentation></sendTask>
    <sendTask id="n_116_inv" name="Issue the invoice with its count and rate"><documentation>11.6.2. 47 U.S.C. 224(g) and 47 CFR 1.1408(a) also make a utility that provides telecom or cable services itself impute the same rate to its own costs and charge any affiliate. The rate you bill is the rate you pay yourself.</documentation></sendTask>
    <serviceTask id="n_116_age" name="Age the receivable"><documentation>11.6.2. Non-payment is a contract matter. It is not a 224(f)(2) ground and does not license withholding access.</documentation></serviceTask>
    <endEvent id="n_116_end" name="Billed"/>
    <startEvent id="n_116_s" name="Joint ownership settlement due"><timerEventDefinition id="n_116_s_td"/></startEvent>
    <serviceTask id="n_116_pos" name="Calculate each party's position on the ratio"><documentation>11.6.3.</documentation></serviceTask>
    <receiveTask id="n_116_ex" name="Exchange counts with the counterparty"><documentation>11.6.3.</documentation></receiveTask>
    <exclusiveGateway id="n_116_dg" name="Counts agree"/>
    <sendTask id="n_116_hold" name="Hold settlement for a joint audit"><documentation>11.6.3. A count difference is not a dispute until both parties have reconciled from the same audit at 11.4.5.</documentation></sendTask>
    <serviceTask id="n_116_net" name="Net the positions to one settlement"><documentation>11.6.3. Two parties invoicing gross on the same poles doubles the reconciliation and hides the difference that matters, which is the count.</documentation></serviceTask>
    <endEvent id="n_116_send" name="Settled"/>
    <startEvent id="n_116_p" name="Owner invoices the utility for rent"><messageEventDefinition id="n_116_p_md"/></startEvent>
    <userTask id="n_116_ver" name="Verify against the utility's outbound permits"><documentation>11.6.4. From 11.2.6. Paying what you cannot reconcile is how a utility rents attachments it removed years ago.</documentation></userTask>
    <exclusiveGateway id="n_116_pg" name="Reconciles"/>
    <sendTask id="n_116_dis" name="Withhold the line and refer to 11.6.6"><documentation>11.6.4.</documentation></sendTask>
    <serviceTask id="n_116_pay" name="Release the verified rent for payment"><documentation>11.6.4. Rent for occupying somebody else's plant - not 13.4.4 goods and not 16.4.3 contractor pay.</documentation></serviceTask>
    <endEvent id="n_116_pend" name="Rent verified and released"/>
    <sequenceFlow id="f_n_116_t_n_116_cnt" sourceRef="n_116_t" targetRef="n_116_cnt" name=""/>
    <sequenceFlow id="f_n_116_cnt_n_116_calc" sourceRef="n_116_cnt" targetRef="n_116_calc" name=""/>
    <sequenceFlow id="f_n_116_calc_n_116_cg" sourceRef="n_116_calc" targetRef="n_116_cg" name=""/>
    <sequenceFlow id="f_n_116_cg_n_116_fix" sourceRef="n_116_cg" targetRef="n_116_fix" name="above the ceiling"><conditionExpression xsi:type="tFormalExpression"><![CDATA[withinCeiling = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_116_fix_n_116_keep" sourceRef="n_116_fix" targetRef="n_116_keep" name=""/>
    <sequenceFlow id="f_n_116_cg_n_116_keep" sourceRef="n_116_cg" targetRef="n_116_keep" name="within"/>
    <sequenceFlow id="f_n_116_keep_n_116_rg" sourceRef="n_116_keep" targetRef="n_116_rg" name=""/>
    <sequenceFlow id="f_n_116_rg_n_116_not" sourceRef="n_116_rg" targetRef="n_116_not" name="increasing"><conditionExpression xsi:type="tFormalExpression"><![CDATA[rateIncrease = true]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_116_not_n_116_inv" sourceRef="n_116_not" targetRef="n_116_inv" name=""/>
    <sequenceFlow id="f_n_116_rg_n_116_inv" sourceRef="n_116_rg" targetRef="n_116_inv" name="unchanged"/>
    <sequenceFlow id="f_n_116_inv_n_116_age" sourceRef="n_116_inv" targetRef="n_116_age" name=""/>
    <sequenceFlow id="f_n_116_age_n_116_end" sourceRef="n_116_age" targetRef="n_116_end" name=""/>
    <sequenceFlow id="f_n_116_s_n_116_pos" sourceRef="n_116_s" targetRef="n_116_pos" name=""/>
    <sequenceFlow id="f_n_116_pos_n_116_ex" sourceRef="n_116_pos" targetRef="n_116_ex" name=""/>
    <sequenceFlow id="f_n_116_ex_n_116_dg" sourceRef="n_116_ex" targetRef="n_116_dg" name=""/>
    <sequenceFlow id="f_n_116_dg_n_116_hold" sourceRef="n_116_dg" targetRef="n_116_hold" name="counts differ"><conditionExpression xsi:type="tFormalExpression"><![CDATA[countsAgree = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_116_hold_n_116_ex" sourceRef="n_116_hold" targetRef="n_116_ex" name="audit reconciled"/>
    <sequenceFlow id="f_n_116_dg_n_116_net" sourceRef="n_116_dg" targetRef="n_116_net" name="agree"/>
    <sequenceFlow id="f_n_116_net_n_116_send" sourceRef="n_116_net" targetRef="n_116_send" name=""/>
    <sequenceFlow id="f_n_116_p_n_116_ver" sourceRef="n_116_p" targetRef="n_116_ver" name=""/>
    <sequenceFlow id="f_n_116_ver_n_116_pg" sourceRef="n_116_ver" targetRef="n_116_pg" name=""/>
    <sequenceFlow id="f_n_116_pg_n_116_dis" sourceRef="n_116_pg" targetRef="n_116_dis" name="does not reconcile"><conditionExpression xsi:type="tFormalExpression"><![CDATA[reconciles = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_116_pg_n_116_pay" sourceRef="n_116_pg" targetRef="n_116_pay" name="reconciles"/>
    <sequenceFlow id="f_n_116_pay_n_116_pend" sourceRef="n_116_pay" targetRef="n_116_pend" name=""/>
  </process>
