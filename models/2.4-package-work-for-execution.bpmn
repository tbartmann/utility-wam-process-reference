      <bpmndi:BPMNShape id="sh_n_24_wdraw" bpmnElement="n_24_wdraw"><dc:Bounds x="1785" y="90" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_use" bpmnElement="n_24_use"><dc:Bounds x="1785" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_pub" bpmnElement="n_24_pub"><dc:Bounds x="1955" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_24_end" bpmnElement="n_24_end"><dc:Bounds x="2172" y="217" width="36" height="36"/></bpmndi:BPMNShape>
