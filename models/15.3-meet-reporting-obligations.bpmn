      <bpmndi:BPMNShape id="sh_n_153_e1" bpmnElement="n_153_e1"><dc:Bounds x="1152" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_rt" bpmnElement="n_153_rt"><dc:Bounds x="132" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_meth" bpmnElement="n_153_meth"><dc:Bounds x="297" y="652" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_gas" bpmnElement="n_153_gas"><dc:Bounds x="425" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_el" bpmnElement="n_153_el"><dc:Bounds x="425" y="860" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_class" bpmnElement="n_153_class"><dc:Bounds x="595" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_iss" bpmnElement="n_153_iss"><dc:Bounds x="765" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_e2" bpmnElement="n_153_e2"><dc:Bounds x="982" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_r" bpmnElement="n_153_r"><dc:Bounds x="132" y="1097" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_cls" bpmnElement="n_153_cls"><dc:Bounds x="255" y="1080" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_bind" bpmnElement="n_153_bind"><dc:Bounds x="425" y="1080" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_hold" bpmnElement="n_153_hold"><dc:Bounds x="637" y="1092" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_keep" bpmnElement="n_153_keep"><dc:Bounds x="642" y="1317" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_disp" bpmnElement="n_153_disp"><dc:Bounds x="765" y="1080" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_153_e3" bpmnElement="n_153_e3"><dc:Bounds x="982" y="1097" width="36" height="36"/></bpmndi:BPMNShape>
