<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="Permit_determination" name="2.6.1 Permit and consent determination" namespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <description>Called from 2.6-permits-and-prerequisites.bpmn as a business rule task. The output is the set of applicable permits, determined from location, method and disturbance against jurisdictional rules. Those rules change with jurisdiction far more often than the process around them, which is why this is a table and not a flow. The federal layer is here; the state and municipal layer is a specialization overlay keyed on this decision's uid.</description>
  <inputData id="in_excavation" name="Excavation involved"><variable id="in_excavation_v" name="Excavation involved" typeRef="boolean"/></inputData>
  <inputData id="in_publicWay" name="Work in the public way"><variable id="in_publicWay_v" name="Work in the public way" typeRef="boolean"/></inputData>
  <inputData id="in_disturbedAcres" name="Land disturbance in acres"><variable id="in_disturbedAcres_v" name="Land disturbance in acres" typeRef="number"/></inputData>
  <inputData id="in_watersImpact" name="Waters of the US affected"><variable id="in_watersImpact_v" name="Waters of the US affected" typeRef="boolean"/></inputData>
  <inputData id="in_thirdPartyCrossing" name="Third-party crossing"><variable id="in_thirdPartyCrossing_v" name="Third-party crossing" typeRef="string"/></inputData>
  <inputData id="in_routineMaintenance" name="Routine maintenance in kind"><variable id="in_routineMaintenance_v" name="Routine maintenance in kind" typeRef="boolean"/></inputData>
  <knowledgeSource id="ks_cga" name="CGA Best Practices v22.0, practices 3-16 and 5-1"><description>Damage prevention consensus practice: the content of the locate request and the statutory waiting window before excavation. The excavator's call-before-you-dig duty is STATE one-call statute; 49 CFR 192.614 obliges the operator as facility owner, not as excavator.</description></knowledgeSource>
  <knowledgeSource id="ks_nwp" name="USACE Nationwide Permits 2026 and 40 CFR 122.26"><description>NWP 12 gas pipelines, NWP 57 electric utility lines, NWP 58 other utility lines, NWP 3 maintenance. 40 CFR 122.26(b)(15)(i) sets the small construction disturbance threshold and excludes routine maintenance that maintains original line and grade, hydraulic capacity or purpose.</description></knowledgeSource>
  <knowledgeSource id="ks_mutcd" name="MUTCD 11th Edition Revision 1, Part 6"><description>Temporary traffic control devices for work in the public way. The road-opening or encroachment permit itself is issued under state or municipal ordinance and is not federally standardised.</description></knowledgeSource>
  <decision id="d_2_6_1" name="Permit and consent determination">
    <description>2.6.1. COLLECT hit policy: a single job routinely needs several permits at once and the determination must return all of them with their lead times, not the first match. Additional knowledge sources: USACE NWP 2026 and MUTCD Part 6.</description>
    <variable id="d_2_6_1_v" name="Permit and consent determination" typeRef="string"/>
    <informationRequirement id="ir_d_2_6_1_in_excavation"><requiredInput href="#in_excavation"/></informationRequirement>
    <informationRequirement id="ir_d_2_6_1_in_publicWay"><requiredInput href="#in_publicWay"/></informationRequirement>
    <informationRequirement id="ir_d_2_6_1_in_disturbedAcres"><requiredInput href="#in_disturbedAcres"/></informationRequirement>
    <informationRequirement id="ir_d_2_6_1_in_watersImpact"><requiredInput href="#in_watersImpact"/></informationRequirement>
    <informationRequirement id="ir_d_2_6_1_in_thirdPartyCrossing"><requiredInput href="#in_thirdPartyCrossing"/></informationRequirement>
    <informationRequirement id="ir_d_2_6_1_in_routineMaintenance"><requiredInput href="#in_routineMaintenance"/></informationRequirement>
    <authorityRequirement id="ar_d_2_6_1"><requiredAuthority href="#ks_cga"/></authorityRequirement>
    <decisionTable id="d_2_6_1_dt" hitPolicy="COLLECT" preferredOrientation="Rule-as-Row">
      <input id="d_2_6_1_i1" label="Excavation involved"><inputExpression id="d_2_6_1_i1_e" typeRef="boolean"><text>in_excavation</text></inputExpression></input>
      <input id="d_2_6_1_i2" label="Work in the public way"><inputExpression id="d_2_6_1_i2_e" typeRef="boolean"><text>in_publicWay</text></inputExpression></input>
      <input id="d_2_6_1_i3" label="Land disturbance in acres"><inputExpression id="d_2_6_1_i3_e" typeRef="number"><text>in_disturbedAcres</text></inputExpression></input>
      <input id="d_2_6_1_i4" label="Waters of the US affected"><inputExpression id="d_2_6_1_i4_e" typeRef="boolean"><text>in_watersImpact</text></inputExpression></input>
      <input id="d_2_6_1_i5" label="Third-party crossing"><inputExpression id="d_2_6_1_i5_e" typeRef="string"><text>in_thirdPartyCrossing</text></inputExpression></input>
      <input id="d_2_6_1_i6" label="Routine maintenance in kind"><inputExpression id="d_2_6_1_i6_e" typeRef="boolean"><text>in_routineMaintenance</text></inputExpression></input>
      <output id="d_2_6_1_o" label="Permit and consent determination" name="Permit and consent determination" typeRef="string"/>
      <rule id="d_2_6_1_r1">
        <description>Excavation triggers the statutory notification and its waiting period. The period is state law and is a hard constraint on the earliest start.</description>
        <inputEntry id="d_2_6_1_r1_ie1"><text>true</text></inputEntry>
        <inputEntry id="d_2_6_1_r1_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r1_ie3"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r1_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r1_ie5"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r1_ie6"><text>-</text></inputEntry>
        <outputEntry id="d_2_6_1_r1_oe"><text>"oneCallLocateRequest"</text></outputEntry>
      </rule>
      <rule id="d_2_6_1_r2">
        <description>Devices to MUTCD Part 6.</description>
        <inputEntry id="d_2_6_1_r2_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r2_ie2"><text>true</text></inputEntry>
        <inputEntry id="d_2_6_1_r2_ie3"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r2_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r2_ie5"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r2_ie6"><text>-</text></inputEntry>
        <outputEntry id="d_2_6_1_r2_oe"><text>"trafficControlPlan"</text></outputEntry>
      </rule>
      <rule id="d_2_6_1_r3">
        <description>Issued under state or municipal ordinance. Lead time varies by jurisdiction and is the operator's to record.</description>
        <inputEntry id="d_2_6_1_r3_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r3_ie2"><text>true</text></inputEntry>
        <inputEntry id="d_2_6_1_r3_ie3"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r3_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r3_ie5"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r3_ie6"><text>-</text></inputEntry>
        <outputEntry id="d_2_6_1_r3_oe"><text>"roadOpeningPermit"</text></outputEntry>
      </rule>
      <rule id="d_2_6_1_r4">
        <description>Small construction disturbance threshold. Routine maintenance in kind is excluded.</description>
        <inputEntry id="d_2_6_1_r4_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r4_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r4_ie3"><text>&gt;= 1</text></inputEntry>
        <inputEntry id="d_2_6_1_r4_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r4_ie5"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r4_ie6"><text>false</text></inputEntry>
        <outputEntry id="d_2_6_1_r4_oe"><text>"stormwaterPermit"</text></outputEntry>
      </rule>
      <rule id="d_2_6_1_r5">
        <description>Nationwide permit or individual permit. NWP 3 covers maintenance.</description>
        <inputEntry id="d_2_6_1_r5_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r5_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r5_ie3"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r5_ie4"><text>true</text></inputEntry>
        <inputEntry id="d_2_6_1_r5_ie5"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r5_ie6"><text>false</text></inputEntry>
        <outputEntry id="d_2_6_1_r5_oe"><text>"waterwayAuthorisation"</text></outputEntry>
      </rule>
      <rule id="d_2_6_1_r6">
        <description>Negotiated consent, not a permit. Lead times are the longest in the set and are outside the operator's control.</description>
        <inputEntry id="d_2_6_1_r6_ie1"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r6_ie2"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r6_ie3"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r6_ie4"><text>-</text></inputEntry>
        <inputEntry id="d_2_6_1_r6_ie5"><text>"railroad","waterway","pipeline","foreignUtility"</text></inputEntry>
        <outputEntry id="d_2_6_1_r6_oe"><text>"thirdPartyCrossingConsent"</text></outputEntry>
      </rule>
      <rule id="d_2_6_1_r7">
        <description>Explicit, so that 'no permit' is a recorded determination rather than an omission.</description>
        <inputEntry id="d_2_6_1_r7_ie1"><text>false</text></inputEntry>
        <inputEntry id="d_2_6_1_r7_ie2"><text>false</text></inputEntry>
        <inputEntry id="d_2_6_1_r7_ie3"><text>&lt; 1</text></inputEntry>
        <inputEntry id="d_2_6_1_r7_ie4"><text>false</text></inputEntry>
        <inputEntry id="d_2_6_1_r7_ie5"><text>"none"</text></inputEntry>
        <inputEntry id="d_2_6_1_r7_ie6"><text>-</text></inputEntry>
        <outputEntry id="d_2_6_1_r7_oe"><text>"noPermitRequired"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="drd_Permit_determination">
      <dmndi:DMNShape id="sh_in_excavation" dmnElementRef="in_excavation"><dc:Bounds x="60" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_in_publicWay" dmnElementRef="in_publicWay"><dc:Bounds x="245" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_in_disturbedAcres" dmnElementRef="in_disturbedAcres"><dc:Bounds x="430" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_in_watersImpact" dmnElementRef="in_watersImpact"><dc:Bounds x="615" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_in_thirdPartyCrossing" dmnElementRef="in_thirdPartyCrossing"><dc:Bounds x="800" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_in_routineMaintenance" dmnElementRef="in_routineMaintenance"><dc:Bounds x="985" y="420" width="160" height="45"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_d_2_6_1" dmnElementRef="d_2_6_1"><dc:Bounds x="60" y="240" width="180" height="70"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_ks_cga" dmnElementRef="ks_cga"><dc:Bounds x="900" y="100" width="160" height="55"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_ks_nwp" dmnElementRef="ks_nwp"><dc:Bounds x="1080" y="100" width="160" height="55"/></dmndi:DMNShape>
      <dmndi:DMNShape id="sh_ks_mutcd" dmnElementRef="ks_mutcd"><dc:Bounds x="1260" y="100" width="160" height="55"/></dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
