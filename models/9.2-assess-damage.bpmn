      <bpmndi:BPMNShape id="sh_n_92_est" bpmnElement="n_92_est"><dc:Bounds x="1105" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_92_r" bpmnElement="n_92_r"><dc:Bounds x="132" y="767" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_92_col" bpmnElement="n_92_col"><dc:Bounds x="255" y="750" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_92_rec" bpmnElement="n_92_rec"><dc:Bounds x="425" y="750" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_92_res" bpmnElement="n_92_res"><dc:Bounds x="595" y="750" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_92_fg" bpmnElement="n_92_fg"><dc:Bounds x="807" y="762" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_92_re" bpmnElement="n_92_re"><dc:Bounds x="765" y="970" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_92_rev" bpmnElement="n_92_rev"><dc:Bounds x="935" y="750" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_92_pub" bpmnElement="n_92_pub"><dc:Bounds x="1105" y="750" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_92_end" bpmnElement="n_92_end"><dc:Bounds x="1322" y="437" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_92_start_n_92_val" bpmnElement="f_n_92_start_n_92_val"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
