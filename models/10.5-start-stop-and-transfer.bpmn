      <bpmndi:BPMNShape id="sh_n_105_pair" bpmnElement="n_105_pair"><dc:Bounds x="1275" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_105_read" bpmnElement="n_105_read"><dc:Bounds x="1445" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_105_rel" bpmnElement="n_105_rel"><dc:Bounds x="1615" y="200" width="130" height="70"/></bpmndi:BPMNShape>
