      <bpmndi:BPMNShape id="sh_n_121_locw" bpmnElement="n_121_locw"><dc:Bounds x="595" y="631.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_121_att" bpmnElement="n_121_att"><dc:Bounds x="425" y="851.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_121_attw" bpmnElement="n_121_attw"><dc:Bounds x="595" y="851.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_121_ret" bpmnElement="n_121_ret"><dc:Bounds x="425" y="1080" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_121_retw" bpmnElement="n_121_retw"><dc:Bounds x="595" y="1065" width="130" height="100"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_121_join" bpmnElement="n_121_join"><dc:Bounds x="807" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_121_pub" bpmnElement="n_121_pub"><dc:Bounds x="935" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_121_end" bpmnElement="n_121_end"><dc:Bounds x="1152" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_121_start_n_121_kind" bpmnElement="f_n_121_start_n_121_kind"><di:waypoint x="168" y="235"/><di:waypoint x="297" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_121_kind_n_121_new" bpmnElement="f_n_121_kind_n_121_new"><di:waypoint x="343" y="235"/><di:waypoint x="425" y="235"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="356.8" y="213" width="54.4" height="17" />
