      <bpmndi:BPMNEdge id="ed_f_n_193_cls_n_193_gw" bpmnElement="f_n_193_cls_n_193_gw"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
