<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_5_3" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_5_3" name="5.3 Capitalise and unitise completed work" isExecutable="false">
    <documentation>Tier-4 activities under 5.3.2, 5.3.3 and 5.3.4. The treatment confirmation 5.3.1 is a determination and is in 5.3.1-capitalisation-confirmation.dmn. Note the retention asymmetry this group creates: 18 CFR 125.3 keeps the continuing plant inventory ledger for 25 years and the work order sheets behind it for 5 years after clearance to plant account, so the property record outlives its own evidence by twenty years. That is why the record has to be right at posting.</documentation>
    <startEvent id="n_53_start" name="Settled work order requires its treatment"><messageEventDefinition id="n_53_start_md"/></startEvent>
    <businessRuleTask id="n_53_conf" name="Confirm the accounting treatment"><documentation>5.3.1. Calls decision Capitalisation_confirmation.</documentation></businessRuleTask>
    <exclusiveGateway id="n_53_gate" name="Treatment"/>
    <serviceTask id="n_53_exp" name="Post to maintenance expense"><documentation>5.3.1. Expensed work leaves the capital path here.</documentation></serviceTask>
    <endEvent id="n_53_endexp" name="Expensed"/>
    <userTask id="n_53_add" name="Identify the retirement units added"><documentation>5.3.2.</documentation></userTask>
    <userTask id="n_53_rem" name="Identify the retirement units removed"><documentation>5.3.2.</documentation></userTask>
    <serviceTask id="n_53_dist" name="Distribute settled cost across the units added"><documentation>5.3.2. From the as-built at 5.4.3, not from the design. Unitising against the design puts the wrong units in a record kept for twenty-five years.</documentation></serviceTask>
    <serviceTask id="n_53_post" name="Post additions and retirements to plant"><documentation>5.3.3. Retirements at original cost, which is what the continuing plant inventory record makes possible.</documentation></serviceTask>
    <serviceTask id="n_53_cpr" name="Update the continuing plant inventory record"><documentation>5.3.3. Required by 18 CFR 101 Definition 8.</documentation></serviceTask>
    <serviceTask id="n_53_rec" name="Reconcile plant account to property record"><documentation>5.3.3. A difference between them is a real difference in what the utility believes it owns.</documentation></serviceTask>
    <exclusiveGateway id="n_53_pj" name="Last work order on the project"/>
    <userTask id="n_53_var" name="Record the outturn variance against the estimate"><documentation>5.3.4. The only honest feedback the estimating process at 2.3 ever receives.</documentation></userTask>
    <serviceTask id="n_53_close" name="Close the project and release funding"><documentation>5.3.4.</documentation></serviceTask>
    <endEvent id="n_53_end" name="Capitalised and posted"/>
    <sequenceFlow id="f_n_53_start_n_53_conf" sourceRef="n_53_start" targetRef="n_53_conf" name=""/>
    <sequenceFlow id="f_n_53_conf_n_53_gate" sourceRef="n_53_conf" targetRef="n_53_gate" name=""/>
    <sequenceFlow id="f_n_53_gate_n_53_exp" sourceRef="n_53_gate" targetRef="n_53_exp" name="expense"><conditionExpression xsi:type="tFormalExpression"><![CDATA[treatment = "expense"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_53_exp_n_53_endexp" sourceRef="n_53_exp" targetRef="n_53_endexp" name=""/>
    <sequenceFlow id="f_n_53_gate_n_53_add" sourceRef="n_53_gate" targetRef="n_53_add" name="capital"/>
    <sequenceFlow id="f_n_53_add_n_53_rem" sourceRef="n_53_add" targetRef="n_53_rem" name=""/>
    <sequenceFlow id="f_n_53_rem_n_53_dist" sourceRef="n_53_rem" targetRef="n_53_dist" name=""/>
    <sequenceFlow id="f_n_53_dist_n_53_post" sourceRef="n_53_dist" targetRef="n_53_post" name=""/>
    <sequenceFlow id="f_n_53_post_n_53_cpr" sourceRef="n_53_post" targetRef="n_53_cpr" name=""/>
    <sequenceFlow id="f_n_53_cpr_n_53_rec" sourceRef="n_53_cpr" targetRef="n_53_rec" name=""/>
    <sequenceFlow id="f_n_53_rec_n_53_pj" sourceRef="n_53_rec" targetRef="n_53_pj" name=""/>
    <sequenceFlow id="f_n_53_pj_n_53_var" sourceRef="n_53_pj" targetRef="n_53_var" name="last order on the project"><conditionExpression xsi:type="tFormalExpression"><![CDATA[lastOrderOnProject = true]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_53_var_n_53_close" sourceRef="n_53_var" targetRef="n_53_close" name=""/>
    <sequenceFlow id="f_n_53_close_n_53_end" sourceRef="n_53_close" targetRef="n_53_end" name=""/>
    <sequenceFlow id="f_n_53_pj_n_53_end" sourceRef="n_53_pj" targetRef="n_53_end" name="project remains open"/>
  </process>
  <bpmndi:BPMNDiagram id="dg_P_5_3">
    <bpmndi:BPMNPlane id="pl_P_5_3" bpmnElement="P_5_3">
      <bpmndi:BPMNShape id="sh_n_53_start" bpmnElement="n_53_start"><dc:Bounds x="132" y="217" width="36" height="36"/></bpmndi:BPMNShape>
