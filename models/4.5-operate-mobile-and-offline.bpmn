      <bpmndi:BPMNShape id="sh_n_45_as" bpmnElement="n_45_as"><dc:Bounds x="255" y="631.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_45_cfg" bpmnElement="n_45_cfg"><dc:Bounds x="425" y="631.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_45_ref" bpmnElement="n_45_ref"><dc:Bounds x="595" y="631.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_45_ev" bpmnElement="n_45_ev"><dc:Bounds x="807" y="652" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_45_resp" bpmnElement="n_45_resp"><dc:Bounds x="765" y="860" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_45_rem" bpmnElement="n_45_rem"><dc:Bounds x="935" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_45_end2" bpmnElement="n_45_end2"><dc:Bounds x="1152" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_45_start_n_45_q" bpmnElement="f_n_45_start_n_45_q"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_q_n_45_ack" bpmnElement="f_n_45_q_n_45_ack"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_ack_n_45_cf" bpmnElement="f_n_45_ack_n_45_cf"><di:waypoint x="555" y="235"/><di:waypoint x="637" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_cf_n_45_route" bpmnElement="f_n_45_cf_n_45_route"><di:waypoint x="683" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="455"/><di:waypoint x="595" y="455"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="516.2" y="446.5" width="48.8" height="17" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_route_n_45_ret" bpmnElement="f_n_45_route_n_45_ret"><di:waypoint x="725" y="455"/><di:waypoint x="740" y="455"/><di:waypoint x="740" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_cf_n_45_ret" bpmnElement="f_n_45_cf_n_45_ret"><di:waypoint x="683" y="235"/><di:waypoint x="765" y="235"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="704" y="213" width="40" height="17" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_ret_n_45_end" bpmnElement="f_n_45_ret_n_45_end"><di:waypoint x="895" y="235"/><di:waypoint x="982" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_d_n_45_as" bpmnElement="f_n_45_d_n_45_as"><di:waypoint x="168" y="675"/><di:waypoint x="255" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_as_n_45_cfg" bpmnElement="f_n_45_as_n_45_cfg"><di:waypoint x="385" y="675"/><di:waypoint x="425" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_cfg_n_45_ref" bpmnElement="f_n_45_cfg_n_45_ref"><di:waypoint x="555" y="675"/><di:waypoint x="595" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_ref_n_45_ev" bpmnElement="f_n_45_ref_n_45_ev"><di:waypoint x="725" y="675"/><di:waypoint x="807" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_ev_n_45_resp" bpmnElement="f_n_45_ev_n_45_resp"><di:waypoint x="853" y="675"/><di:waypoint x="740" y="675"/><di:waypoint x="740" y="895"/><di:waypoint x="765" y="895"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="641.4" y="880" width="93.6" height="30" />
