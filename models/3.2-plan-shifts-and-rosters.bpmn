      <bpmndi:BPMNEdge id="ed_f_n_32_gap_n_32_close" bpmnElement="f_n_32_gap_n_32_close"><di:waypoint x="1193" y="235"/><di:waypoint x="1275" y="235"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1206.8" y="213" width="54.4" height="17" />
