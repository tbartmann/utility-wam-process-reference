<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_11_5" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_11_5" name="11.5 Manage transfers and structure replacement" isExecutable="false">
    <documentation>11.5.1, 11.5.3, 11.5.4 and 11.5.5 are drawn; the multi-party sequence is a case at 11.5.2. This group exists as its own group because of one sentence: 47 CFR 1.1411(j)(3) says self-help is not available for pole replacements. Everywhere else in this category a missed deadline lets the attacher do the work itself. Here it does not, so the transfer backlog is the utility's problem to run and there is no remedy that routes around it. 47 U.S.C. 224(h) and 47 CFR 1.1403(c) set the notice, and closing a transfer on assertion rather than evidence is how the backlog at 11.5.4 becomes invisible for years.</documentation>
    <laneSet id="P_11_5_lanes">
      <lane id="l_115_ju" name="Joint use administration">
        <flowNodeRef>n_115_start</flowNodeRef>
        <flowNodeRef>n_115_who</flowNodeRef>
        <flowNodeRef>n_115_em</flowNodeRef>
        <flowNodeRef>n_115_not</flowNodeRef>
        <flowNodeRef>n_115_open</flowNodeRef>
        <flowNodeRef>n_115_seq</flowNodeRef>
        <flowNodeRef>n_115_age</flowNodeRef>
        <flowNodeRef>n_115_ag</flowNodeRef>
        <flowNodeRef>n_115_esc</flowNodeRef>
        <flowNodeRef>n_115_chg</flowNodeRef>
        <flowNodeRef>n_115_ev</flowNodeRef>
        <flowNodeRef>n_115_clear</flowNodeRef>
        <flowNodeRef>n_115_dw</flowNodeRef>
        <flowNodeRef>n_115_end</flowNodeRef>
        <flowNodeRef>n_115_v</flowNodeRef>
        <flowNodeRef>n_115_dang</flowNodeRef>
        <flowNodeRef>n_115_emer</flowNodeRef>
        <flowNodeRef>n_115_attr</flowNodeRef>
        <flowNodeRef>n_115_fix</flowNodeRef>
        <flowNodeRef>n_115_req</flowNodeRef>
        <flowNodeRef>n_115_vend</flowNodeRef>
      </lane>
      <lane id="l_115_con" name="Construction">
        <flowNodeRef>n_115_rem</flowNodeRef>
        <flowNodeRef>n_115_own</flowNodeRef>
        <flowNodeRef>n_115_ver</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="n_115_start" name="Structure to be replaced or modified"><messageEventDefinition id="n_115_start_md"/></startEvent>
    <serviceTask id="n_115_who" name="Identify every attacher of record"><documentation>11.5.1. From 11.4.1. An attacher missed here is a transfer nobody asked for.</documentation></serviceTask>
    <exclusiveGateway id="n_115_em" name="Emergency"/>
    <sendTask id="n_115_not" name="Give the 60-day written notice"><documentation>11.5.1. 47 U.S.C. 224(h) and 47 CFR 1.1403(c). Make-ready, routine maintenance and emergency response are outside it.</documentation></sendTask>
    <serviceTask id="n_115_open" name="Open a transfer obligation per attacher"><documentation>11.5.1.</documentation></serviceTask>
    <callActivity id="n_115_seq" name="Run the multi-party sequence (11.5.2)"><documentation>11.5.2. Supply sits above the communication worker safety zone, so the order is a safety matter and not an administrative one.</documentation></callActivity>
    <serviceTask id="n_115_age" name="Age every open obligation against its notice"><documentation>11.5.3.</documentation></serviceTask>
    <exclusiveGateway id="n_115_ag" name="Overdue"/>
    <userTask id="n_115_esc" name="Chase and escalate"><documentation>11.5.3.</documentation></userTask>
    <sendTask id="n_115_chg" name="Refer a chargeable delay to 11.6.5"><documentation>11.5.3.</documentation></sendTask>
    <userTask id="n_115_ev" name="Close only on evidence the equipment moved"><documentation>11.5.3. Closing on a party's assertion is how a double-wood backlog disappears from the record and not from the field.</documentation></userTask>
    <exclusiveGateway id="n_115_clear" name="Structure clear"/>
    <userTask id="n_115_dw" name="Add to the double-wood backlog"><documentation>11.5.4. A stub structure is a live asset: it loads the right-of-way, it is inspected, and it appears in a count somebody bills from.</documentation></userTask>
    <serviceTask id="n_115_rem" name="Remove the old structure"><documentation>11.5.4. 5.3 posts the retirement; this clears the field condition.</documentation></serviceTask>
    <endEvent id="n_115_end" name="Structure cleared"/>
    <startEvent id="n_115_v" name="Clearance or safety violation reported"><messageEventDefinition id="n_115_v_md"/></startEvent>
    <exclusiveGateway id="n_115_dang" name="Immediate danger"/>
    <sendTask id="n_115_emer" name="Route to 9.1 as an emergency"><documentation>11.5.5. It returns here afterwards for attribution and recharge.</documentation></sendTask>
    <userTask id="n_115_attr" name="Attribute the violation to a party"><documentation>11.5.5. Another party's violation is not the new attacher's to fix or fund - 1.1411(e)(4) and 1.1416(b) both say so.</documentation></userTask>
    <exclusiveGateway id="n_115_fix" name="Who corrects"/>
    <sendTask id="n_115_req" name="Require the responsible party to correct"><documentation>11.5.5.</documentation></sendTask>
    <userTask id="n_115_own" name="Correct it and recharge"><documentation>11.5.5.</documentation></userTask>
    <userTask id="n_115_ver" name="Verify the correction and close on evidence"><documentation>11.5.5.</documentation></userTask>
    <endEvent id="n_115_vend" name="Violation closed"/>
    <sequenceFlow id="f_n_115_start_n_115_who" sourceRef="n_115_start" targetRef="n_115_who" name=""/>
    <sequenceFlow id="f_n_115_who_n_115_em" sourceRef="n_115_who" targetRef="n_115_em" name=""/>
    <sequenceFlow id="f_n_115_em_n_115_not" sourceRef="n_115_em" targetRef="n_115_not" name="planned"><conditionExpression xsi:type="tFormalExpression"><![CDATA[emergency = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_115_not_n_115_open" sourceRef="n_115_not" targetRef="n_115_open" name=""/>
    <sequenceFlow id="f_n_115_em_n_115_open" sourceRef="n_115_em" targetRef="n_115_open" name="emergency, outside the notice"/>
    <sequenceFlow id="f_n_115_open_n_115_seq" sourceRef="n_115_open" targetRef="n_115_seq" name=""/>
    <sequenceFlow id="f_n_115_seq_n_115_age" sourceRef="n_115_seq" targetRef="n_115_age" name=""/>
    <sequenceFlow id="f_n_115_age_n_115_ag" sourceRef="n_115_age" targetRef="n_115_ag" name=""/>
    <sequenceFlow id="f_n_115_ag_n_115_esc" sourceRef="n_115_ag" targetRef="n_115_esc" name="overdue"><conditionExpression xsi:type="tFormalExpression"><![CDATA[overdue = true]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_115_esc_n_115_chg" sourceRef="n_115_esc" targetRef="n_115_chg" name=""/>
    <sequenceFlow id="f_n_115_chg_n_115_ev" sourceRef="n_115_chg" targetRef="n_115_ev" name=""/>
    <sequenceFlow id="f_n_115_ag_n_115_ev" sourceRef="n_115_ag" targetRef="n_115_ev" name="within the period"/>
    <sequenceFlow id="f_n_115_ev_n_115_clear" sourceRef="n_115_ev" targetRef="n_115_clear" name=""/>
    <sequenceFlow id="f_n_115_clear_n_115_dw" sourceRef="n_115_clear" targetRef="n_115_dw" name="attachments remain"><conditionExpression xsi:type="tFormalExpression"><![CDATA[clear = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_115_dw_n_115_age" sourceRef="n_115_dw" targetRef="n_115_age" name="back to ageing"/>
    <sequenceFlow id="f_n_115_clear_n_115_rem" sourceRef="n_115_clear" targetRef="n_115_rem" name="clear"/>
    <sequenceFlow id="f_n_115_rem_n_115_end" sourceRef="n_115_rem" targetRef="n_115_end" name=""/>
    <sequenceFlow id="f_n_115_v_n_115_dang" sourceRef="n_115_v" targetRef="n_115_dang" name=""/>
    <sequenceFlow id="f_n_115_dang_n_115_emer" sourceRef="n_115_dang" targetRef="n_115_emer" name="immediate danger"><conditionExpression xsi:type="tFormalExpression"><![CDATA[immediateDanger = true]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_115_emer_n_115_attr" sourceRef="n_115_emer" targetRef="n_115_attr" name=""/>
    <sequenceFlow id="f_n_115_dang_n_115_attr" sourceRef="n_115_dang" targetRef="n_115_attr" name="no immediate danger"/>
    <sequenceFlow id="f_n_115_attr_n_115_fix" sourceRef="n_115_attr" targetRef="n_115_fix" name=""/>
    <sequenceFlow id="f_n_115_fix_n_115_req" sourceRef="n_115_fix" targetRef="n_115_req" name="attributable"><conditionExpression xsi:type="tFormalExpression"><![CDATA[attributable = true]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_115_fix_n_115_own" sourceRef="n_115_fix" targetRef="n_115_own" name="unattributable"/>
    <sequenceFlow id="f_n_115_req_n_115_ver" sourceRef="n_115_req" targetRef="n_115_ver" name=""/>
    <sequenceFlow id="f_n_115_own_n_115_ver" sourceRef="n_115_own" targetRef="n_115_ver" name=""/>
    <sequenceFlow id="f_n_115_ver_n_115_vend" sourceRef="n_115_ver" targetRef="n_115_vend" name=""/>
  </process>
