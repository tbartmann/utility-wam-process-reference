      <bpmndi:BPMNShape id="sh_n_42_susp" bpmnElement="n_42_susp"><dc:Bounds x="1275" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_42_res" bpmnElement="n_42_res"><dc:Bounds x="1445" y="200" width="130" height="70"/></bpmndi:BPMNShape>
