      <bpmndi:BPMNEdge id="ed_f_n_153_rt_n_153_meth" bpmnElement="f_n_153_rt_n_153_meth"><di:waypoint x="168" y="675"/><di:waypoint x="297" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_153_meth_n_153_gas" bpmnElement="f_n_153_meth_n_153_gas"><di:waypoint x="343" y="675"/><di:waypoint x="425" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_153_meth_n_153_el" bpmnElement="f_n_153_meth_n_153_el"><di:waypoint x="343" y="675"/><di:waypoint x="400" y="675"/><di:waypoint x="400" y="895"/><di:waypoint x="425" y="895"/></bpmndi:BPMNEdge>
