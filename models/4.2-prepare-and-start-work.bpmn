      <bpmndi:BPMNShape id="sh_n_42_sub" bpmnElement="n_42_sub"><dc:Bounds x="1785" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_42_chk" bpmnElement="n_42_chk"><dc:Bounds x="1955" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_42_temp" bpmnElement="n_42_temp"><dc:Bounds x="2125" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_42_rel" bpmnElement="n_42_rel"><dc:Bounds x="2295" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_42_end" bpmnElement="n_42_end"><dc:Bounds x="2512" y="217" width="36" height="36"/></bpmndi:BPMNShape>
