<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_10_2" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_10_2" name="10.2 Manage service orders" isExecutable="false">
    <documentation>Tier-4 activities under 10.2.1 to 10.2.4. IEC 61968-6 cl. 5 names ServiceOrder as a payload and Annex A supplies create, change, cancel and close; it does not specify catalogue, eligibility, dispatch or execution. ISO/IEC 20000-1:2018 cl. 8.6.2 is cited as a labelled ITSM analogue for intake only. Placement is 3.4: this path calls the scheduler, it does not become one.</documentation>
    <laneSet id="P_10_2_lanes">
      <lane id="l_102_cs" name="Customer service">
        <flowNodeRef>n_102_start</flowNodeRef>
        <flowNodeRef>n_102_cls</flowNodeRef>
        <flowNodeRef>n_102_bind</flowNodeRef>
        <flowNodeRef>n_102_elg</flowNodeRef>
        <flowNodeRef>n_102_hold</flowNodeRef>
        <flowNodeRef>n_102_create</flowNodeRef>
        <flowNodeRef>n_102_chg</flowNodeRef>
        <flowNodeRef>n_102_who</flowNodeRef>
        <flowNodeRef>n_102_disp</flowNodeRef>
        <flowNodeRef>n_102_cancel</flowNodeRef>
        <flowNodeRef>n_102_close</flowNodeRef>
        <flowNodeRef>n_102_end</flowNodeRef>
      </lane>
      <lane id="l_102_schd" name="Scheduling and dispatch">
        <flowNodeRef>n_102_place</flowNodeRef>
        <flowNodeRef>n_102_gate</flowNodeRef>
        <flowNodeRef>n_102_ghold</flowNodeRef>
        <flowNodeRef>n_102_send</flowNodeRef>
        <flowNodeRef>n_102_rel</flowNodeRef>
        <flowNodeRef>n_102_rebook</flowNodeRef>
      </lane>
      <lane id="l_102_frd" name="Field">
        <flowNodeRef>n_102_arr</flowNodeRef>
        <flowNodeRef>n_102_do</flowNodeRef>
        <flowNodeRef>n_102_cap</flowNodeRef>
        <flowNodeRef>n_102_og</flowNodeRef>
        <flowNodeRef>n_102_ret</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="n_102_start" name="Work requested at a premise"><messageEventDefinition id="n_102_start_md"/></startEvent>
    <userTask id="n_102_cls" name="Classify against the published service catalogue"><documentation>10.2.1. Catalogue content is operator judgment; no standard supplies one.</documentation></userTask>
    <serviceTask id="n_102_bind" name="Bind customer, premise and any meter"><documentation>10.2.1.</documentation></serviceTask>
    <exclusiveGateway id="n_102_elg" name="Identity and eligibility settled"/>
    <userTask id="n_102_hold" name="Hold with the missing fact named"><documentation>10.2.1. Held against a named fact, not parked.</documentation></userTask>
    <serviceTask id="n_102_create" name="Create the ServiceOrder"><documentation>10.2.1. ServiceOrder.create.</documentation></serviceTask>
    <callActivity id="n_102_place" name="Place the order through 3.4"><documentation>10.2.2. The scheduler is 3.4. Building a second optimiser here is how two calendars start disagreeing about the same crew.</documentation></callActivity>
    <exclusiveGateway id="n_102_gate" name="Dispatch gates clear"/>
    <userTask id="n_102_ghold" name="Hold against the named gate"><documentation>10.2.2. 29 CFR 1910.269(c) briefing, (a)(2) qualified employee and (l) minimum approach distance are process constraints on assignment and start. 10.1.3 access notes are the third gate. A clearance, where the work needs one, is issued at 18.4.4 against a switching plan approved at 18.2.2 - it is not a permit and it is not granted here.</documentation></userTask>
    <sendTask id="n_102_send" name="Dispatch to the field"><documentation>10.2.2.</documentation></sendTask>
    <userTask id="n_102_arr" name="Arrive, brief and confirm the premise"><documentation>10.2.3. The briefing is 1910.269(c) and happens before the job, not on the form afterwards.</documentation></userTask>
    <userTask id="n_102_do" name="Perform the prescribed service work"><documentation>10.2.3. Method is not a standards domain. Gas meter work still takes 49 CFR 192.353 location and 192.357 installation; excavation takes 1926 Subpart P.</documentation></userTask>
    <serviceTask id="n_102_cap" name="Capture outcome, reading and customer contact"><documentation>10.2.3. IEC 61968-6 FRD records the outcome; it does not specify the work.</documentation></serviceTask>
    <exclusiveGateway id="n_102_og" name="Order completed"/>
    <sendTask id="n_102_ret" name="Return the order with the reason"><documentation>10.2.3. Unable and partial are outcomes with reasons, not silent non-events.</documentation></sendTask>
    <startEvent id="n_102_chg" name="Order cannot proceed as placed"><conditionalEventDefinition id="n_102_chg_cd"><condition/></conditionalEventDefinition></startEvent>
    <serviceTask id="n_102_who" name="Record who initiated the change"><documentation>10.2.4. Crew-caused no-access is a schedule miss. Customer-caused no-access is not. Mixing them hides both.</documentation></serviceTask>
    <sendTask id="n_102_rel" name="Release or move the reserved capacity through 3.3"><documentation>10.2.4. Capacity not released leaves 3.3.2 holding ghost hours.</documentation></sendTask>
    <exclusiveGateway id="n_102_disp" name="Disposition"/>
    <serviceTask id="n_102_rebook" name="Rebook or return to the ready bank"><documentation>10.2.4.</documentation></serviceTask>
    <endEvent id="n_102_cancel" name="Order cancelled"/>
    <serviceTask id="n_102_close" name="Close the ServiceOrder on the outcome"><documentation>10.2.3. ServiceOrder.close.</documentation></serviceTask>
    <endEvent id="n_102_end" name="Service order closed"/>
    <sequenceFlow id="f_n_102_start_n_102_cls" sourceRef="n_102_start" targetRef="n_102_cls" name=""/>
    <sequenceFlow id="f_n_102_cls_n_102_bind" sourceRef="n_102_cls" targetRef="n_102_bind" name=""/>
    <sequenceFlow id="f_n_102_bind_n_102_elg" sourceRef="n_102_bind" targetRef="n_102_elg" name=""/>
    <sequenceFlow id="f_n_102_elg_n_102_hold" sourceRef="n_102_elg" targetRef="n_102_hold" name="identity or eligibility open"><conditionExpression xsi:type="tFormalExpression"><![CDATA[eligibilitySettled = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_102_hold_n_102_elg" sourceRef="n_102_hold" targetRef="n_102_elg" name="fact supplied"/>
    <sequenceFlow id="f_n_102_elg_n_102_create" sourceRef="n_102_elg" targetRef="n_102_create" name="settled"/>
    <sequenceFlow id="f_n_102_create_n_102_place" sourceRef="n_102_create" targetRef="n_102_place" name=""/>
    <sequenceFlow id="f_n_102_place_n_102_gate" sourceRef="n_102_place" targetRef="n_102_gate" name=""/>
    <sequenceFlow id="f_n_102_gate_n_102_ghold" sourceRef="n_102_gate" targetRef="n_102_ghold" name="a gate is not clear"><conditionExpression xsi:type="tFormalExpression"><![CDATA[dispatchGatesClear = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_102_ghold_n_102_gate" sourceRef="n_102_ghold" targetRef="n_102_gate" name="gate cleared"/>
    <sequenceFlow id="f_n_102_gate_n_102_send" sourceRef="n_102_gate" targetRef="n_102_send" name="clear"/>
    <sequenceFlow id="f_n_102_send_n_102_arr" sourceRef="n_102_send" targetRef="n_102_arr" name=""/>
    <sequenceFlow id="f_n_102_arr_n_102_do" sourceRef="n_102_arr" targetRef="n_102_do" name=""/>
    <sequenceFlow id="f_n_102_do_n_102_cap" sourceRef="n_102_do" targetRef="n_102_cap" name=""/>
    <sequenceFlow id="f_n_102_cap_n_102_og" sourceRef="n_102_cap" targetRef="n_102_og" name=""/>
    <sequenceFlow id="f_n_102_og_n_102_ret" sourceRef="n_102_og" targetRef="n_102_ret" name="unable or partial"><conditionExpression xsi:type="tFormalExpression"><![CDATA[completed = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_102_og_n_102_close" sourceRef="n_102_og" targetRef="n_102_close" name="completed"/>
    <sequenceFlow id="f_n_102_close_n_102_end" sourceRef="n_102_close" targetRef="n_102_end" name=""/>
    <sequenceFlow id="f_n_102_ret_n_102_who" sourceRef="n_102_ret" targetRef="n_102_who" name=""/>
    <sequenceFlow id="f_n_102_chg_n_102_who" sourceRef="n_102_chg" targetRef="n_102_who" name=""/>
    <sequenceFlow id="f_n_102_who_n_102_rel" sourceRef="n_102_who" targetRef="n_102_rel" name=""/>
    <sequenceFlow id="f_n_102_rel_n_102_disp" sourceRef="n_102_rel" targetRef="n_102_disp" name=""/>
    <sequenceFlow id="f_n_102_disp_n_102_cancel" sourceRef="n_102_disp" targetRef="n_102_cancel" name="cancelled"><conditionExpression xsi:type="tFormalExpression"><![CDATA[disposition = "cancel"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_102_disp_n_102_rebook" sourceRef="n_102_disp" targetRef="n_102_rebook" name="amend or rebook"/>
    <sequenceFlow id="f_n_102_rebook_n_102_place" sourceRef="n_102_rebook" targetRef="n_102_place" name="back to placement"/>
  </process>
