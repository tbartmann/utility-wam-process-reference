      <bpmndi:BPMNShape id="sh_n_22_mat" bpmnElement="n_22_mat"><dc:Bounds x="765" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_ext" bpmnElement="n_22_ext"><dc:Bounds x="595" y="411.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_ret" bpmnElement="n_22_ret"><dc:Bounds x="765" y="411.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_join" bpmnElement="n_22_join"><dc:Bounds x="977" y="322" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_basis" bpmnElement="n_22_basis"><dc:Bounds x="1105" y="301.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_allow" bpmnElement="n_22_allow"><dc:Bounds x="1275" y="301.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_est" bpmnElement="n_22_est"><dc:Bounds x="1445" y="301.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_end" bpmnElement="n_22_end"><dc:Bounds x="1662" y="327" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_rstart" bpmnElement="n_22_rstart"><dc:Bounds x="1152" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_reest" bpmnElement="n_22_reest"><dc:Bounds x="1275" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_rclass" bpmnElement="n_22_rclass"><dc:Bounds x="1445" y="631.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_keep" bpmnElement="n_22_keep"><dc:Bounds x="1615" y="631.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_22_rend" bpmnElement="n_22_rend"><dc:Bounds x="1832" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_22_start_n_22_class" bpmnElement="f_n_22_start_n_22_class"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_class_n_22_split" bpmnElement="f_n_22_class_n_22_split"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_split_n_22_lab" bpmnElement="f_n_22_split_n_22_lab"><di:waypoint x="513" y="235"/><di:waypoint x="595" y="235"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="524" y="200" width="60" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_split_n_22_ext" bpmnElement="f_n_22_split_n_22_ext"><di:waypoint x="513" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="455"/><di:waypoint x="595" y="455"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="505" y="440" width="60" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_lab_n_22_mat" bpmnElement="f_n_22_lab_n_22_mat"><di:waypoint x="725" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_mat_n_22_join" bpmnElement="f_n_22_mat_n_22_join"><di:waypoint x="895" y="235"/><di:waypoint x="952" y="235"/><di:waypoint x="952" y="345"/><di:waypoint x="977" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_ext_n_22_ret" bpmnElement="f_n_22_ext_n_22_ret"><di:waypoint x="725" y="455"/><di:waypoint x="765" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_ret_n_22_join" bpmnElement="f_n_22_ret_n_22_join"><di:waypoint x="895" y="455"/><di:waypoint x="952" y="455"/><di:waypoint x="952" y="345"/><di:waypoint x="977" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_22_join_n_22_basis" bpmnElement="f_n_22_join_n_22_basis"><di:waypoint x="1023" y="345"/><di:waypoint x="1105" y="345"/></bpmndi:BPMNEdge>
