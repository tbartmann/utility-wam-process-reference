      <bpmndi:BPMNEdge id="ed_f_n_24_std_n_24_crew" bpmnElement="f_n_24_std_n_24_crew"><di:waypoint x="385" y="125"/><di:waypoint x="910" y="125"/><di:waypoint x="910" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_24_lib_n_24_tasks" bpmnElement="f_n_24_lib_n_24_tasks"><di:waypoint x="343" y="235"/><di:waypoint x="425" y="235"/>
