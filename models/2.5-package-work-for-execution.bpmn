      <bpmndi:BPMNShape id="sh_n_25_tool" bpmnElement="n_25_tool"><dc:Bounds x="1105" y="90" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_mat" bpmnElement="n_25_mat"><dc:Bounds x="1105" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_stock" bpmnElement="n_25_stock"><dc:Bounds x="1317" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_req" bpmnElement="n_25_req"><dc:Bounds x="1275" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_held" bpmnElement="n_25_held"><dc:Bounds x="1492" y="437" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_res" bpmnElement="n_25_res"><dc:Bounds x="1445" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_doc" bpmnElement="n_25_doc"><dc:Bounds x="1615" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_wdraw" bpmnElement="n_25_wdraw"><dc:Bounds x="1785" y="90" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_use" bpmnElement="n_25_use"><dc:Bounds x="1785" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_pub" bpmnElement="n_25_pub"><dc:Bounds x="1955" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_25_end" bpmnElement="n_25_end"><dc:Bounds x="2172" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_25_start_n_25_lib" bpmnElement="f_n_25_start_n_25_lib"><di:waypoint x="168" y="235"/><di:waypoint x="297" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_lib_n_25_std" bpmnElement="f_n_25_lib_n_25_std"><di:waypoint x="343" y="235"/><di:waypoint x="230" y="235"/><di:waypoint x="230" y="125"/><di:waypoint x="255" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_std_n_25_crew" bpmnElement="f_n_25_std_n_25_crew"><di:waypoint x="385" y="125"/><di:waypoint x="910" y="125"/><di:waypoint x="910" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_lib_n_25_tasks" bpmnElement="f_n_25_lib_n_25_tasks"><di:waypoint x="343" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_tasks_n_25_proc" bpmnElement="f_n_25_tasks_n_25_proc"><di:waypoint x="555" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_proc_n_25_crit" bpmnElement="f_n_25_proc_n_25_crit"><di:waypoint x="725" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_crit_n_25_crew" bpmnElement="f_n_25_crit_n_25_crew"><di:waypoint x="895" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_crew_n_25_tool" bpmnElement="f_n_25_crew_n_25_tool"><di:waypoint x="1065" y="235"/><di:waypoint x="1080" y="235"/><di:waypoint x="1080" y="125"/><di:waypoint x="1105" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_crew_n_25_mat" bpmnElement="f_n_25_crew_n_25_mat"><di:waypoint x="1065" y="235"/><di:waypoint x="1105" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_mat_n_25_stock" bpmnElement="f_n_25_mat_n_25_stock"><di:waypoint x="1235" y="235"/><di:waypoint x="1317" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_stock_n_25_req" bpmnElement="f_n_25_stock_n_25_req"><di:waypoint x="1363" y="235"/><di:waypoint x="1250" y="235"/><di:waypoint x="1250" y="455"/><di:waypoint x="1275" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_req_n_25_held" bpmnElement="f_n_25_req_n_25_held"><di:waypoint x="1405" y="455"/><di:waypoint x="1492" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_stock_n_25_res" bpmnElement="f_n_25_stock_n_25_res"><di:waypoint x="1363" y="235"/><di:waypoint x="1445" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_res_n_25_doc" bpmnElement="f_n_25_res_n_25_doc"><di:waypoint x="1575" y="235"/><di:waypoint x="1615" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_doc_n_25_wdraw" bpmnElement="f_n_25_doc_n_25_wdraw"><di:waypoint x="1745" y="235"/><di:waypoint x="1760" y="235"/><di:waypoint x="1760" y="125"/><di:waypoint x="1785" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_doc_n_25_use" bpmnElement="f_n_25_doc_n_25_use"><di:waypoint x="1745" y="235"/><di:waypoint x="1785" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_use_n_25_pub" bpmnElement="f_n_25_use_n_25_pub"><di:waypoint x="1915" y="235"/><di:waypoint x="1955" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_25_pub_n_25_end" bpmnElement="f_n_25_pub_n_25_end"><di:waypoint x="2085" y="235"/><di:waypoint x="2172" y="235"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
