      <bpmndi:BPMNShape id="sh_n_165_val" bpmnElement="n_165_val"><dc:Bounds x="255" y="631.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_165_vg" bpmnElement="n_165_vg"><dc:Bounds x="467" y="652" width="46" height="46"/></bpmndi:BPMNShape>
