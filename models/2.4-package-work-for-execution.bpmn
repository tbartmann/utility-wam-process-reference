<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_2_4" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_2_4" name="2.4 Package work for execution" isExecutable="false">
    <documentation>Tier-4 activities under 2.4.1 to 2.4.4. EN 17007:2017 cl. 6.5.3 ACT.2 Prepare for the maintenance tasks is the process; cl. 6.10 DOC and cl. 6.16 SPP supply the documentation and spare parts. NOTE: no standard specifies what a work package or job plan must CONTAIN - EN 13460:2009 Annex B is informative and the only prescriptive list, 7 CFR 1724.53(b)(1), binds RUS borrowers only. The task structure below is framed against ACT.2; the content is the operator's.</documentation>
    <startEvent id="n_24_start" name="Authorised work requires a job plan"><messageEventDefinition id="n_24_start_md"/></startEvent>
    <exclusiveGateway id="n_24_lib" name="Plan source"/>
    <serviceTask id="n_24_std" name="Instantiate the standard job plan"><documentation>2.4.1 variant. From the library, for repeat work.</documentation></serviceTask>
    <userTask id="n_24_tasks" name="Break the work into tasks with sequence and dependencies"><documentation>2.4.1.</documentation></userTask>
    <userTask id="n_24_proc" name="Attach the procedure or method statement to each task"><documentation>2.4.1.</documentation></userTask>
    <userTask id="n_24_crit" name="State the acceptance criteria per task"><documentation>2.4.1. A task with no acceptance criterion cannot be verified complete, so closure becomes a judgement call in the field.</documentation></userTask>
    <userTask id="n_24_crew" name="Determine crew composition and qualification"><documentation>2.4.2. Where a task is a covered task under 49 CFR 192 Subpart N the qualification belongs on the work here, not as a check at dispatch.</documentation></userTask>
    <userTask id="n_24_tool" name="State plant, tools and access equipment"><documentation>2.4.2.</documentation></userTask>
    <serviceTask id="n_24_mat" name="Derive the material requirement"><documentation>2.4.4.</documentation></serviceTask>
    <exclusiveGateway id="n_24_stock" name="Material available"/>
    <sendTask id="n_24_req" name="Requisition against lead time"><documentation>2.4.4. Non-stock material. Reserving late converts a planning problem into a schedule failure.</documentation></sendTask>
    <endEvent id="n_24_held" name="Held for material"/>
    <serviceTask id="n_24_res" name="Reserve the material"><documentation>2.4.4.</documentation></serviceTask>
    <userTask id="n_24_doc" name="Assemble drawings, procedures and permits at revision"><documentation>2.4.3. At the current revision, fixed on the work.</documentation></userTask>
    <serviceTask id="n_24_wdraw" name="Withdraw superseded documents"><documentation>2.4.3. Superseded revisions left in a package get built. Withdrawal is part of assembly, not a separate tidy-up.</documentation></serviceTask>
    <serviceTask id="n_24_use" name="Confirm availability at the place of use"><documentation>2.4.3. EN 17007 cl. 6.10 DOC: up-to-date and usable documents at the place of use. A package assembled correctly but not available in the field has failed.</documentation></serviceTask>
    <sendTask id="n_24_pub" name="Publish the requirement to resource planning"><documentation>2.4.2 and 2.4.4.</documentation></sendTask>
    <endEvent id="n_24_end" name="Work packaged"/>
    <sequenceFlow id="f_n_24_start_n_24_lib" sourceRef="n_24_start" targetRef="n_24_lib" name=""/>
    <sequenceFlow id="f_n_24_lib_n_24_std" sourceRef="n_24_lib" targetRef="n_24_std" name="standard plan exists"><conditionExpression xsi:type="tFormalExpression"><![CDATA[jobPlanSource = "library"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_24_std_n_24_crew" sourceRef="n_24_std" targetRef="n_24_crew" name=""/>
    <sequenceFlow id="f_n_24_lib_n_24_tasks" sourceRef="n_24_lib" targetRef="n_24_tasks" name="plan built for this work"/>
    <sequenceFlow id="f_n_24_tasks_n_24_proc" sourceRef="n_24_tasks" targetRef="n_24_proc" name=""/>
    <sequenceFlow id="f_n_24_proc_n_24_crit" sourceRef="n_24_proc" targetRef="n_24_crit" name=""/>
    <sequenceFlow id="f_n_24_crit_n_24_crew" sourceRef="n_24_crit" targetRef="n_24_crew" name=""/>
    <sequenceFlow id="f_n_24_crew_n_24_tool" sourceRef="n_24_crew" targetRef="n_24_tool" name=""/>
    <sequenceFlow id="f_n_24_crew_n_24_mat" sourceRef="n_24_crew" targetRef="n_24_mat" name=""/>
    <sequenceFlow id="f_n_24_mat_n_24_stock" sourceRef="n_24_mat" targetRef="n_24_stock" name=""/>
    <sequenceFlow id="f_n_24_stock_n_24_req" sourceRef="n_24_stock" targetRef="n_24_req" name="not in stock"><conditionExpression xsi:type="tFormalExpression"><![CDATA[materialAvailable = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_24_req_n_24_held" sourceRef="n_24_req" targetRef="n_24_held" name=""/>
    <sequenceFlow id="f_n_24_stock_n_24_res" sourceRef="n_24_stock" targetRef="n_24_res" name="available"/>
    <sequenceFlow id="f_n_24_res_n_24_doc" sourceRef="n_24_res" targetRef="n_24_doc" name=""/>
    <sequenceFlow id="f_n_24_doc_n_24_wdraw" sourceRef="n_24_doc" targetRef="n_24_wdraw" name=""/>
    <sequenceFlow id="f_n_24_doc_n_24_use" sourceRef="n_24_doc" targetRef="n_24_use" name=""/>
    <sequenceFlow id="f_n_24_use_n_24_pub" sourceRef="n_24_use" targetRef="n_24_pub" name=""/>
    <sequenceFlow id="f_n_24_pub_n_24_end" sourceRef="n_24_pub" targetRef="n_24_end" name=""/>
  </process>
  <bpmndi:BPMNDiagram id="dg_P_2_4">
    <bpmndi:BPMNPlane id="pl_P_2_4" bpmnElement="P_2_4">
      <bpmndi:BPMNShape id="sh_n_24_start" bpmnElement="n_24_start"><dc:Bounds x="132" y="217" width="36" height="36"/></bpmndi:BPMNShape>
