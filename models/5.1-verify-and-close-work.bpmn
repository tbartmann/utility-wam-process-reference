<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_5_1" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_5_1" name="5.1 Verify and close work" isExecutable="false">
    <documentation>Tier-4 activities under 5.1.1 to 5.1.4. EN 17007 cl. 6.5.8 ACT.7 is the process. For gas the review is a duty rather than a preference: 49 CFR 192.605(b)(8) requires the operator to periodically review the work done by its personnel to determine the effectiveness and adequacy of the procedures used.</documentation>
    <startEvent id="n_51_start" name="Crew reports work complete"><messageEventDefinition id="n_51_start_md"/></startEvent>
    <serviceTask id="n_51_collect" name="Collect the completion record"><documentation>5.1.1.</documentation></serviceTask>
    <userTask id="n_51_ev" name="Check evidence against the acceptance criteria"><documentation>5.1.1. The criteria were set at 2.5.1. Without them completion is whoever says so.</documentation></userTask>
    <exclusiveGateway id="n_51_evg" name="Evidence complete"/>
    <userTask id="n_51_hold" name="Hold for the missing evidence"><documentation>5.1.1. Held, not closed with a note to follow.</documentation></userTask>
    <userTask id="n_51_qual" name="Apply the quality and compliance check"><documentation>5.1.2. Self-check, independent inspection, or regulatory witness by work type.</documentation></userTask>
    <serviceTask id="n_51_obl" name="Discharge the obligation the work was raised against"><documentation>5.1.2. Evidence is recorded against the obligation, not only the work.</documentation></serviceTask>
    <exclusiveGateway id="n_51_qg" name="Standard met"/>
    <userTask id="n_51_nc" name="Raise the nonconformity"><documentation>5.1.3.</documentation></userTask>
    <exclusiveGateway id="n_51_disp" name="Disposition"/>
    <userTask id="n_51_conc" name="Accept under recorded concession"><documentation>5.1.3. Not available where a regulatory obligation is what failed.</documentation></userTask>
    <sendTask id="n_51_rework" name="Raise rework linked to the original work"><documentation>5.1.3. Linked, or the rework rate stops meaning anything.</documentation></sendTask>
    <endEvent id="n_51_endrw" name="Rework raised"/>
    <serviceTask id="n_51_conf" name="Confirm verification, compliance and evidence"><documentation>5.1.4.</documentation></serviceTask>
    <serviceTask id="n_51_close" name="Close the tasks and the work order"><documentation>5.1.4.</documentation></serviceTask>
    <sendTask id="n_51_rel" name="Release reservations, permits and clearances"><documentation>5.1.4. Closure that does not release them leaves material committed and windows blocked.</documentation></sendTask>
    <serviceTask id="n_51_ret" name="Enter the record into retention"><documentation>5.1.4. For gas the repair record on pipe is retained for as long as the pipe remains in service. The clock starts here.</documentation></serviceTask>
    <sendTask id="n_51_settle" name="Signal cost settlement"><documentation>5.1.4. Hooks to 5.2.</documentation></sendTask>
    <endEvent id="n_51_end" name="Work closed"/>
    <sequenceFlow id="f_n_51_start_n_51_collect" sourceRef="n_51_start" targetRef="n_51_collect" name=""/>
    <sequenceFlow id="f_n_51_collect_n_51_ev" sourceRef="n_51_collect" targetRef="n_51_ev" name=""/>
    <sequenceFlow id="f_n_51_ev_n_51_evg" sourceRef="n_51_ev" targetRef="n_51_evg" name=""/>
    <sequenceFlow id="f_n_51_evg_n_51_hold" sourceRef="n_51_evg" targetRef="n_51_hold" name="evidence missing"><conditionExpression xsi:type="tFormalExpression"><![CDATA[evidenceComplete = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_51_hold_n_51_ev" sourceRef="n_51_hold" targetRef="n_51_ev" name="evidence returned"/>
    <sequenceFlow id="f_n_51_evg_n_51_qual" sourceRef="n_51_evg" targetRef="n_51_qual" name="complete"/>
    <sequenceFlow id="f_n_51_qual_n_51_obl" sourceRef="n_51_qual" targetRef="n_51_obl" name=""/>
    <sequenceFlow id="f_n_51_obl_n_51_qg" sourceRef="n_51_obl" targetRef="n_51_qg" name=""/>
    <sequenceFlow id="f_n_51_qg_n_51_nc" sourceRef="n_51_qg" targetRef="n_51_nc" name="standard not met"><conditionExpression xsi:type="tFormalExpression"><![CDATA[conformity = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_51_nc_n_51_disp" sourceRef="n_51_nc" targetRef="n_51_disp" name=""/>
    <sequenceFlow id="f_n_51_disp_n_51_conc" sourceRef="n_51_disp" targetRef="n_51_conc" name="concession, non-regulatory only"><conditionExpression xsi:type="tFormalExpression"><![CDATA[disposition = "concession"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_51_disp_n_51_rework" sourceRef="n_51_disp" targetRef="n_51_rework" name="correct or rework"/>
    <sequenceFlow id="f_n_51_conc_n_51_conf" sourceRef="n_51_conc" targetRef="n_51_conf" name=""/>
    <sequenceFlow id="f_n_51_rework_n_51_endrw" sourceRef="n_51_rework" targetRef="n_51_endrw" name=""/>
    <sequenceFlow id="f_n_51_qg_n_51_conf" sourceRef="n_51_qg" targetRef="n_51_conf" name="standard met"/>
    <sequenceFlow id="f_n_51_conf_n_51_close" sourceRef="n_51_conf" targetRef="n_51_close" name=""/>
    <sequenceFlow id="f_n_51_close_n_51_rel" sourceRef="n_51_close" targetRef="n_51_rel" name=""/>
    <sequenceFlow id="f_n_51_close_n_51_ret" sourceRef="n_51_close" targetRef="n_51_ret" name=""/>
    <sequenceFlow id="f_n_51_ret_n_51_settle" sourceRef="n_51_ret" targetRef="n_51_settle" name=""/>
    <sequenceFlow id="f_n_51_settle_n_51_end" sourceRef="n_51_settle" targetRef="n_51_end" name=""/>
  </process>
