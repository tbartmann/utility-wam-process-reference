      <bpmndi:BPMNEdge id="ed_f_n_62_start_n_62_sp" bpmnElement="f_n_62_start_n_62_sp"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_62_sp_n_62_kind" bpmnElement="f_n_62_sp_n_62_kind"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
