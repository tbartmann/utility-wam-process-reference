      <bpmndi:BPMNEdge id="ed_f_n_184_xwho_n_184_xinf" bpmnElement="f_n_184_xwho_n_184_xinf"><di:waypoint x="343" y="1115"/><di:waypoint x="425" y="1115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_184_xinf_n_184_xnew" bpmnElement="f_n_184_xinf_n_184_xnew"><di:waypoint x="555" y="1115"/><di:waypoint x="595" y="1115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_184_xnew_n_184_xreg" bpmnElement="f_n_184_xnew_n_184_xreg"><di:waypoint x="725" y="1115"/><di:waypoint x="765" y="1115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_184_xreg_n_184_xend" bpmnElement="f_n_184_xreg_n_184_xend"><di:waypoint x="895" y="1115"/><di:waypoint x="982" y="1115"/></bpmndi:BPMNEdge>
