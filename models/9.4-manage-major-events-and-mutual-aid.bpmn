<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_9_4" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_9_4" name="9.4 Manage major events and mutual aid" isExecutable="false">
    <documentation>9.4.1, 9.4.2, 9.4.3, 9.4.5 and 9.4.6 are drawn; logistics is a case at 9.4.4. The Source Authority Pack names Edison Electric Institute mutual assistance material but gives no document, edition or process, so the sequence here is the operator's and is labelled as such. What IS regulated gets drawn: 49 CFR 192.615(b)(1) and (2) put current procedures in the hands of supervisors responsible for emergency action and train the appropriate personnel, 192.615(c)(4) requires planning mutual assistance with public officials, and 29 CFR 1910.269(a)(3) makes the host and the visiting employer exchange installation, hazard and work-rule information BEFORE work. A visiting crew is a contract employer arriving at speed, and the duty does not relax because the event is an emergency.</documentation>
    <laneSet id="P_9_4_lanes">
      <lane id="l_94_evt" name="Event command">
        <flowNodeRef>n_94_sig</flowNodeRef>
        <flowNodeRef>n_94_act</flowNodeRef>
        <flowNodeRef>n_94_not</flowNodeRef>
        <flowNodeRef>n_94_xfer</flowNodeRef>
        <flowNodeRef>n_94_conf</flowNodeRef>
        <flowNodeRef>n_94_dem</flowNodeRef>
        <flowNodeRef>n_94_gap</flowNodeRef>
        <flowNodeRef>n_94_req</flowNodeRef>
        <flowNodeRef>n_94_off</flowNodeRef>
        <flowNodeRef>n_94_plan</flowNodeRef>
        <flowNodeRef>n_94_dm</flowNodeRef>
        <flowNodeRef>n_94_elig</flowNodeRef>
        <flowNodeRef>n_94_dg</flowNodeRef>
        <flowNodeRef>n_94_open</flowNodeRef>
        <flowNodeRef>n_94_free</flowNodeRef>
        <flowNodeRef>n_94_end</flowNodeRef>
      </lane>
      <lane id="l_94_hr" name="Visiting crews">
        <flowNodeRef>n_94_arr</flowNodeRef>
        <flowNodeRef>n_94_ros</flowNodeRef>
        <flowNodeRef>n_94_host</flowNodeRef>
        <flowNodeRef>n_94_qual</flowNodeRef>
        <flowNodeRef>n_94_qg</flowNodeRef>
        <flowNodeRef>n_94_hold</flowNodeRef>
        <flowNodeRef>n_94_brief</flowNodeRef>
        <flowNodeRef>n_94_rel</flowNodeRef>
      </lane>
      <lane id="l_94_fin" name="Event cost">
        <flowNodeRef>n_94_cost</flowNodeRef>
        <flowNodeRef>n_94_cval</flowNodeRef>
        <flowNodeRef>n_94_csep</flowNodeRef>
        <flowNodeRef>n_94_csum</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="n_94_sig" name="Event exceeds normal operational control"><signalEventDefinition id="n_94_sig_sd"/></startEvent>
    <userTask id="n_94_act" name="Designate the event lead and functional roles"><documentation>9.4.1. The pack supplies no cross-commodity activation levels or organisation chart, so neither is drawn.</documentation></userTask>
    <sendTask id="n_94_not" name="Notify assigned personnel and supervisors"><documentation>9.4.1. 49 CFR 192.615(b)(1) and (2) for gas.</documentation></sendTask>
    <serviceTask id="n_94_xfer" name="Transfer event, hazard and restoration information"><documentation>9.4.1.</documentation></serviceTask>
    <serviceTask id="n_94_conf" name="Confirm command, control and communication active"><documentation>9.4.1.</documentation></serviceTask>
    <serviceTask id="n_94_dem" name="Compare demand with committed internal capacity"><documentation>9.4.2.</documentation></serviceTask>
    <exclusiveGateway id="n_94_gap" name="Capacity gap"/>
    <sendTask id="n_94_req" name="Request internal, external or mutual-assistance crews"><documentation>9.4.2. 49 CFR 192.615(c)(4) covers planning mutual assistance with public officials for gas.</documentation></sendTask>
    <receiveTask id="n_94_off" name="Receive offers and commitments"><documentation>9.4.2.</documentation></receiveTask>
    <sendTask id="n_94_plan" name="Assign reporting location, window and event contact"><documentation>9.4.2.</documentation></sendTask>
    <startEvent id="n_94_arr" name="Visiting crew checks in"><messageEventDefinition id="n_94_arr_md"/></startEvent>
    <serviceTask id="n_94_ros" name="Receive the roster and qualification information"><documentation>9.4.3.</documentation></serviceTask>
    <userTask id="n_94_host" name="Transfer host installation, operating and hazard information"><documentation>9.4.3. 29 CFR 1910.269(a)(3). Host and contract employer inform each other, and an emergency does not suspend it.</documentation></userTask>
    <userTask id="n_94_qual" name="Verify role, qualification and crew composition"><documentation>9.4.3. Gas covered tasks stay under 49 CFR 192 Subpart N.</documentation></userTask>
    <exclusiveGateway id="n_94_qg" name="Accepted"/>
    <userTask id="n_94_hold" name="Hold or restrict the crew"><documentation>9.4.3. Restrictions are recorded, so dispatch can see them.</documentation></userTask>
    <userTask id="n_94_brief" name="Host orientation and job briefing"><documentation>9.4.3. 29 CFR 1910.269(c) for electric work.</documentation></userTask>
    <sendTask id="n_94_rel" name="Release the crew to restoration dispatch"><documentation>9.4.3.</documentation></sendTask>
    <serviceTask id="n_94_cost" name="Collect labour, equipment, material and logistics charges"><documentation>9.4.5. Against an event cost identifier established when the event activated.</documentation></serviceTask>
    <userTask id="n_94_cval" name="Validate charges against work, crew and material records"><documentation>9.4.5.</documentation></userTask>
    <userTask id="n_94_csep" name="Separate unsupported, duplicate and disputed charges"><documentation>9.4.5. Regulatory-recovery eligibility and account treatment are jurisdiction-specific and are not in the pack, so no eligibility test is drawn.</documentation></userTask>
    <serviceTask id="n_94_csum" name="Summarise cost with a traceable evidence chain"><documentation>9.4.5. Every included cost keeps its source work, resource and charge trace, because that trace is the whole basis of a recovery filing.</documentation></serviceTask>
    <startEvent id="n_94_dm" name="Demand falls or assigned work complete"><conditionalEventDefinition id="n_94_dm_cd"><condition/></conditionalEventDefinition></startEvent>
    <userTask id="n_94_elig" name="Identify resources eligible for release"><documentation>9.4.6.</documentation></userTask>
    <exclusiveGateway id="n_94_dg" name="Work, equipment and records accounted for"/>
    <userTask id="n_94_open" name="Hold the release against the open item"><documentation>9.4.6. A resource released before its work, its issued equipment and its records have an accountable disposition leaves all three with nobody.</documentation></userTask>
    <sendTask id="n_94_free" name="Communicate release, travel and destination"><documentation>9.4.6.</documentation></sendTask>
    <endEvent id="n_94_end" name="Resources released and event closed out"/>
    <sequenceFlow id="f_n_94_sig_n_94_act" sourceRef="n_94_sig" targetRef="n_94_act" name=""/>
    <sequenceFlow id="f_n_94_act_n_94_not" sourceRef="n_94_act" targetRef="n_94_not" name=""/>
    <sequenceFlow id="f_n_94_not_n_94_xfer" sourceRef="n_94_not" targetRef="n_94_xfer" name=""/>
    <sequenceFlow id="f_n_94_xfer_n_94_conf" sourceRef="n_94_xfer" targetRef="n_94_conf" name=""/>
    <sequenceFlow id="f_n_94_conf_n_94_dem" sourceRef="n_94_conf" targetRef="n_94_dem" name=""/>
    <sequenceFlow id="f_n_94_dem_n_94_gap" sourceRef="n_94_dem" targetRef="n_94_gap" name=""/>
    <sequenceFlow id="f_n_94_gap_n_94_req" sourceRef="n_94_gap" targetRef="n_94_req" name="demand exceeds capacity"><conditionExpression xsi:type="tFormalExpression"><![CDATA[capacityGap = true]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_94_req_n_94_off" sourceRef="n_94_req" targetRef="n_94_off" name=""/>
    <sequenceFlow id="f_n_94_off_n_94_plan" sourceRef="n_94_off" targetRef="n_94_plan" name=""/>
    <sequenceFlow id="f_n_94_plan_n_94_cost" sourceRef="n_94_plan" targetRef="n_94_cost" name=""/>
    <sequenceFlow id="f_n_94_gap_n_94_cost" sourceRef="n_94_gap" targetRef="n_94_cost" name="capacity sufficient"/>
    <sequenceFlow id="f_n_94_arr_n_94_ros" sourceRef="n_94_arr" targetRef="n_94_ros" name=""/>
    <sequenceFlow id="f_n_94_ros_n_94_host" sourceRef="n_94_ros" targetRef="n_94_host" name=""/>
    <sequenceFlow id="f_n_94_host_n_94_qual" sourceRef="n_94_host" targetRef="n_94_qual" name=""/>
    <sequenceFlow id="f_n_94_qual_n_94_qg" sourceRef="n_94_qual" targetRef="n_94_qg" name=""/>
    <sequenceFlow id="f_n_94_qg_n_94_hold" sourceRef="n_94_qg" targetRef="n_94_hold" name="not accepted"><conditionExpression xsi:type="tFormalExpression"><![CDATA[crewAccepted = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_94_hold_n_94_qual" sourceRef="n_94_hold" targetRef="n_94_qual" name="resolved"/>
    <sequenceFlow id="f_n_94_qg_n_94_brief" sourceRef="n_94_qg" targetRef="n_94_brief" name="accepted"/>
    <sequenceFlow id="f_n_94_brief_n_94_rel" sourceRef="n_94_brief" targetRef="n_94_rel" name=""/>
    <sequenceFlow id="f_n_94_cost_n_94_cval" sourceRef="n_94_cost" targetRef="n_94_cval" name=""/>
    <sequenceFlow id="f_n_94_cval_n_94_csep" sourceRef="n_94_cval" targetRef="n_94_csep" name=""/>
    <sequenceFlow id="f_n_94_csep_n_94_csum" sourceRef="n_94_csep" targetRef="n_94_csum" name=""/>
    <sequenceFlow id="f_n_94_csum_n_94_dm" sourceRef="n_94_csum" targetRef="n_94_dm" name=""/>
    <sequenceFlow id="f_n_94_dm_n_94_elig" sourceRef="n_94_dm" targetRef="n_94_elig" name=""/>
    <sequenceFlow id="f_n_94_elig_n_94_dg" sourceRef="n_94_elig" targetRef="n_94_dg" name=""/>
    <sequenceFlow id="f_n_94_dg_n_94_open" sourceRef="n_94_dg" targetRef="n_94_open" name="something outstanding"><conditionExpression xsi:type="tFormalExpression"><![CDATA[accountedFor = false]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_94_open_n_94_dg" sourceRef="n_94_open" targetRef="n_94_dg" name="disposition recorded"/>
    <sequenceFlow id="f_n_94_dg_n_94_free" sourceRef="n_94_dg" targetRef="n_94_free" name="accounted for"/>
    <sequenceFlow id="f_n_94_free_n_94_end" sourceRef="n_94_free" targetRef="n_94_end" name=""/>
  </process>
