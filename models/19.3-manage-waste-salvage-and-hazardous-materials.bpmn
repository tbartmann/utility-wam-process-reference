      <bpmndi:BPMNShape id="sh_n_193_reclass" bpmnElement="n_193_reclass"><dc:Bounds x="765" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_193_file" bpmnElement="n_193_file"><dc:Bounds x="1275" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_193_hand" bpmnElement="n_193_hand"><dc:Bounds x="1445" y="200" width="130" height="70"/></bpmndi:BPMNShape>
