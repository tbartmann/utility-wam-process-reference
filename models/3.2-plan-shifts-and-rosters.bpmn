      <bpmndi:BPMNShape id="sh_n_32_split" bpmnElement="n_32_split"><dc:Bounds x="1105" y="411.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_32_commit" bpmnElement="n_32_commit"><dc:Bounds x="1275" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_32_close" bpmnElement="n_32_close"><dc:Bounds x="1275" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_32_issue" bpmnElement="n_32_issue"><dc:Bounds x="1445" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_32_sched" bpmnElement="n_32_sched"><dc:Bounds x="1615" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_32_ack" bpmnElement="n_32_ack"><dc:Bounds x="1785" y="191.5" width="130" height="87"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_32_end" bpmnElement="n_32_end"><dc:Bounds x="2002" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_32_start_n_32_cover" bpmnElement="f_n_32_start_n_32_cover"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_32_cover_n_32_place" bpmnElement="f_n_32_cover_n_32_place"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_32_place_n_32_bal" bpmnElement="f_n_32_place_n_32_bal"><di:waypoint x="555" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_32_bal_n_32_draft" bpmnElement="f_n_32_bal_n_32_draft"><di:waypoint x="725" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_32_lstart_n_32_leave" bpmnElement="f_n_32_lstart_n_32_leave"><di:waypoint x="678" y="455"/><di:waypoint x="765" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_32_leave_n_32_standby" bpmnElement="f_n_32_leave_n_32_standby"><di:waypoint x="895" y="455"/><di:waypoint x="935" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_32_standby_n_32_test" bpmnElement="f_n_32_standby_n_32_test"><di:waypoint x="1065" y="455"/><di:waypoint x="910" y="455"/><di:waypoint x="910" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_32_draft_n_32_test" bpmnElement="f_n_32_draft_n_32_test"><di:waypoint x="895" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_32_test_n_32_gap" bpmnElement="f_n_32_test_n_32_gap"><di:waypoint x="1065" y="235"/><di:waypoint x="1147" y="235"/></bpmndi:BPMNEdge>
