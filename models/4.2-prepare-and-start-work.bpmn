      <bpmndi:BPMNEdge id="ed_f_n_42_rev_n_42_pre" bpmnElement="f_n_42_rev_n_42_pre"><di:waypoint x="385" y="235"/><di:waypoint x="425" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_42_pre_n_42_ok" bpmnElement="f_n_42_pre_n_42_ok"><di:waypoint x="555" y="235"/><di:waypoint x="637" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_42_ok_n_42_ref" bpmnElement="f_n_42_ok_n_42_ref"><di:waypoint x="683" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="455"/><di:waypoint x="595" y="455"/></bpmndi:BPMNEdge>
