      <bpmndi:BPMNEdge id="ed_f_n_162_pack_n_162_haz" bpmnElement="f_n_162_pack_n_162_haz"><di:waypoint x="1405" y="235"/><di:waypoint x="1445" y="235"/></bpmndi:BPMNEdge>
