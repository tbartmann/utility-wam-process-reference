        <bpmndi:BPMNLabel>
          <dc:Bounds x="647" y="330" width="88" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_gate_n_352_shared" bpmnElement="f_n_352_gate_n_352_shared"><di:waypoint x="683" y="235"/><di:waypoint x="765" y="235"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="666.9" y="173" width="88" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_ded_n_352_rec" bpmnElement="f_n_352_ded_n_352_rec"><di:waypoint x="725" y="125"/><di:waypoint x="910" y="125"/><di:waypoint x="910" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_shared_n_352_rec" bpmnElement="f_n_352_shared_n_352_rec"><di:waypoint x="895" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_spec_n_352_rec" bpmnElement="f_n_352_spec_n_352_rec"><di:waypoint x="895" y="345"/><di:waypoint x="910" y="345"/><di:waypoint x="910" y="235"/><di:waypoint x="935" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_rec_n_352_down" bpmnElement="f_n_352_rec_n_352_down"><di:waypoint x="1065" y="235"/><di:waypoint x="1105" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_down_n_352_pub" bpmnElement="f_n_352_down_n_352_pub"><di:waypoint x="1235" y="235"/><di:waypoint x="1275" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_352_pub_n_352_end" bpmnElement="f_n_352_pub_n_352_end"><di:waypoint x="1405" y="235"/><di:waypoint x="1492" y="235"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
