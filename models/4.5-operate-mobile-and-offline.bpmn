      <bpmndi:BPMNEdge id="ed_f_n_45_resp_n_45_rem" bpmnElement="f_n_45_resp_n_45_rem"><di:waypoint x="895" y="895"/><di:waypoint x="910" y="895"/><di:waypoint x="910" y="675"/><di:waypoint x="935" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_45_ev_n_45_rem" bpmnElement="f_n_45_ev_n_45_rem"><di:waypoint x="853" y="675"/><di:waypoint x="935" y="675"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="831.3" y="626" width="99.2" height="17" />
        </bpmndi:BPMNLabel>
