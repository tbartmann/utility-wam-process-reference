<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_P_2_3" targetNamespace="http://tim-method.example/utility-wam/1.0" exporter="Utility WAM Industry Process Reference" exporterVersion="2026-08-28">
  <process id="P_2_3" name="2.3 Estimate work" isExecutable="false">
    <documentation>Tier-4 activities under 2.3.1, 2.3.2 and 2.3.4. The allowance determination 2.3.3 is in 2.3.3-contingency-and-escalation.dmn. Estimate classification follows AACE 96R-18 for transmission and distribution and 97R-18 for pipeline; AACE states in RP 17R-97 that its recommended practices are guidelines, not standards, and no AACE RP is ANSI-recognised, so they are cited as consensus.</documentation>
    <startEvent id="n_23_start" name="Work requires a cost estimate"><messageEventDefinition id="n_23_start_md"/></startEvent>
    <userTask id="n_23_class" name="Establish the estimate class from definition maturity"><documentation>2.3.1. The class is set by how far the design is defined, not by how much time is available to estimate.</documentation></userTask>
    <exclusiveGateway id="n_23_split" name="Delivery route"/>
    <userTask id="n_23_lab" name="Estimate labour by skill and duration"><documentation>2.3.1.</documentation></userTask>
    <userTask id="n_23_mat" name="Estimate material and equipment"><documentation>2.3.1. From the design where one exists, from history where it does not.</documentation></userTask>
    <userTask id="n_23_ext" name="Estimate against contract or schedule of rates"><documentation>2.3.2. Where no contract is in place the figure is a forecast and must be labelled as one.</documentation></userTask>
    <userTask id="n_23_ret" name="Estimate the retained cost of oversight and acceptance"><documentation>2.3.2. The internal cost of managing external delivery is real and is routinely omitted.</documentation></userTask>
    <exclusiveGateway id="n_23_join" name=""/>
    <userTask id="n_23_basis" name="Document the basis, assumptions and exclusions"><documentation>2.3.1 and 2.3.2. ASTM E2516-11(2024) gives the classification framework for the basis; AACE 34R-05 gives the content.</documentation></userTask>
    <businessRuleTask id="n_23_allow" name="Determine overhead, contingency and escalation"><documentation>2.3.3. Calls decision Allowance_determination in 2.3.3-contingency-and-escalation.dmn.</documentation></businessRuleTask>
    <serviceTask id="n_23_est" name="Record the estimate with allowances stated separately"><documentation>2.3.3. Rolling allowances into the base estimate hides both.</documentation></serviceTask>
    <endEvent id="n_23_end" name="Estimate issued at a stated class"/>
    <startEvent id="n_23_rstart" name="Scope, price or period changes materially"><conditionalEventDefinition id="n_23_rstart_cd"><condition/></conditionalEventDefinition></startEvent>
    <userTask id="n_23_reest" name="Re-estimate the affected scope"><documentation>2.3.4.</documentation></userTask>
    <userTask id="n_23_rclass" name="Restate the estimate class where definition matured"><documentation>2.3.4. Maturing definition should narrow the accuracy range; if it does not, the class was overstated.</documentation></userTask>
    <serviceTask id="n_23_keep" name="Retain the superseded estimate and the reason"><documentation>2.3.4. Without the superseded version the variance cannot be attributed.</documentation></serviceTask>
    <endEvent id="n_23_rend" name="Estimate revised"/>
    <sequenceFlow id="f_n_23_start_n_23_class" sourceRef="n_23_start" targetRef="n_23_class" name=""/>
    <sequenceFlow id="f_n_23_class_n_23_split" sourceRef="n_23_class" targetRef="n_23_split" name=""/>
    <sequenceFlow id="f_n_23_split_n_23_lab" sourceRef="n_23_split" targetRef="n_23_lab" name="internally delivered"><conditionExpression xsi:type="tFormalExpression"><![CDATA[deliveryRoute = "internal"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_23_split_n_23_ext" sourceRef="n_23_split" targetRef="n_23_ext" name="externally delivered"><conditionExpression xsi:type="tFormalExpression"><![CDATA[deliveryRoute = "externalService"]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f_n_23_lab_n_23_mat" sourceRef="n_23_lab" targetRef="n_23_mat" name=""/>
    <sequenceFlow id="f_n_23_mat_n_23_join" sourceRef="n_23_mat" targetRef="n_23_join" name=""/>
    <sequenceFlow id="f_n_23_ext_n_23_ret" sourceRef="n_23_ext" targetRef="n_23_ret" name=""/>
    <sequenceFlow id="f_n_23_ret_n_23_join" sourceRef="n_23_ret" targetRef="n_23_join" name=""/>
    <sequenceFlow id="f_n_23_join_n_23_basis" sourceRef="n_23_join" targetRef="n_23_basis" name=""/>
    <sequenceFlow id="f_n_23_basis_n_23_allow" sourceRef="n_23_basis" targetRef="n_23_allow" name=""/>
    <sequenceFlow id="f_n_23_allow_n_23_est" sourceRef="n_23_allow" targetRef="n_23_est" name=""/>
    <sequenceFlow id="f_n_23_est_n_23_end" sourceRef="n_23_est" targetRef="n_23_end" name=""/>
    <sequenceFlow id="f_n_23_rstart_n_23_reest" sourceRef="n_23_rstart" targetRef="n_23_reest" name=""/>
    <sequenceFlow id="f_n_23_reest_n_23_rclass" sourceRef="n_23_reest" targetRef="n_23_rclass" name=""/>
    <sequenceFlow id="f_n_23_rclass_n_23_keep" sourceRef="n_23_rclass" targetRef="n_23_keep" name=""/>
    <sequenceFlow id="f_n_23_keep_n_23_rend" sourceRef="n_23_keep" targetRef="n_23_rend" name=""/>
  </process>
  <bpmndi:BPMNDiagram id="dg_P_2_3">
    <bpmndi:BPMNPlane id="pl_P_2_3" bpmnElement="P_2_3">
      <bpmndi:BPMNShape id="sh_n_23_start" bpmnElement="n_23_start"><dc:Bounds x="132" y="217" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_class" bpmnElement="n_23_class"><dc:Bounds x="255" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_split" bpmnElement="n_23_split"><dc:Bounds x="467" y="212" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_lab" bpmnElement="n_23_lab"><dc:Bounds x="595" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_mat" bpmnElement="n_23_mat"><dc:Bounds x="765" y="200" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_ext" bpmnElement="n_23_ext"><dc:Bounds x="595" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_ret" bpmnElement="n_23_ret"><dc:Bounds x="765" y="420" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_join" bpmnElement="n_23_join"><dc:Bounds x="977" y="322" width="46" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_basis" bpmnElement="n_23_basis"><dc:Bounds x="1105" y="310" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_allow" bpmnElement="n_23_allow"><dc:Bounds x="1275" y="310" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_est" bpmnElement="n_23_est"><dc:Bounds x="1445" y="310" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_end" bpmnElement="n_23_end"><dc:Bounds x="1662" y="327" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_rstart" bpmnElement="n_23_rstart"><dc:Bounds x="1152" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_reest" bpmnElement="n_23_reest"><dc:Bounds x="1275" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_rclass" bpmnElement="n_23_rclass"><dc:Bounds x="1445" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_keep" bpmnElement="n_23_keep"><dc:Bounds x="1615" y="640" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_n_23_rend" bpmnElement="n_23_rend"><dc:Bounds x="1832" y="657" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_n_23_start_n_23_class" bpmnElement="f_n_23_start_n_23_class"><di:waypoint x="168" y="235"/><di:waypoint x="255" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_class_n_23_split" bpmnElement="f_n_23_class_n_23_split"><di:waypoint x="385" y="235"/><di:waypoint x="467" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_split_n_23_lab" bpmnElement="f_n_23_split_n_23_lab"><di:waypoint x="513" y="235"/><di:waypoint x="595" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_split_n_23_ext" bpmnElement="f_n_23_split_n_23_ext"><di:waypoint x="513" y="235"/><di:waypoint x="570" y="235"/><di:waypoint x="570" y="455"/><di:waypoint x="595" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_lab_n_23_mat" bpmnElement="f_n_23_lab_n_23_mat"><di:waypoint x="725" y="235"/><di:waypoint x="765" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_mat_n_23_join" bpmnElement="f_n_23_mat_n_23_join"><di:waypoint x="895" y="235"/><di:waypoint x="952" y="235"/><di:waypoint x="952" y="345"/><di:waypoint x="977" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_ext_n_23_ret" bpmnElement="f_n_23_ext_n_23_ret"><di:waypoint x="725" y="455"/><di:waypoint x="765" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_ret_n_23_join" bpmnElement="f_n_23_ret_n_23_join"><di:waypoint x="895" y="455"/><di:waypoint x="952" y="455"/><di:waypoint x="952" y="345"/><di:waypoint x="977" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_join_n_23_basis" bpmnElement="f_n_23_join_n_23_basis"><di:waypoint x="1023" y="345"/><di:waypoint x="1105" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_basis_n_23_allow" bpmnElement="f_n_23_basis_n_23_allow"><di:waypoint x="1235" y="345"/><di:waypoint x="1275" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_allow_n_23_est" bpmnElement="f_n_23_allow_n_23_est"><di:waypoint x="1405" y="345"/><di:waypoint x="1445" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_est_n_23_end" bpmnElement="f_n_23_est_n_23_end"><di:waypoint x="1575" y="345"/><di:waypoint x="1662" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_rstart_n_23_reest" bpmnElement="f_n_23_rstart_n_23_reest"><di:waypoint x="1188" y="675"/><di:waypoint x="1275" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_reest_n_23_rclass" bpmnElement="f_n_23_reest_n_23_rclass"><di:waypoint x="1405" y="675"/><di:waypoint x="1445" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_rclass_n_23_keep" bpmnElement="f_n_23_rclass_n_23_keep"><di:waypoint x="1575" y="675"/><di:waypoint x="1615" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_n_23_keep_n_23_rend" bpmnElement="f_n_23_keep_n_23_rend"><di:waypoint x="1745" y="675"/><di:waypoint x="1832" y="675"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
